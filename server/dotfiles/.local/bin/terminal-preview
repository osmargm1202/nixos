#!/usr/bin/env bash
# Text previews work over SSH without graphical image viewers or Nix packages.
set -euo pipefail
path=${1:-}
if [[ -d $path ]]; then
  if command -v eza >/dev/null; then
    exec eza --tree --level=2 --color=always -- "$path"
  elif command -v tree >/dev/null; then
    exec tree -C -L 2 -- "$path"
  fi
  exec ls -la --color=always -- "$path"
elif [[ -f $path ]]; then
  if command -v file >/dev/null && [[ $(file -b --mime-type -- "$path") != text/* ]]; then
    exec file -- "$path"
  elif command -v bat >/dev/null; then
    exec bat --color=always --paging=never --line-range=:150 -- "$path"
  elif command -v batcat >/dev/null; then
    exec batcat --color=always --paging=never --line-range=:150 -- "$path"
  fi
  exec head -n 150 -- "$path"
fi
printf '%s\n' 'Preview unavailable'
