.worktrees/
.gstack/
/result
config/codex/.codex/

# Python bytecode/cache artifacts
__pycache__/
*.py[cod]

# plaintext secrets; only *.age encrypted files belong in git
config/**/.config/bash/private-env.bash
config/**/.config/bash/private-env.bash.tmp
config/**/.config/bash/*.decrypted

# Legacy stow/runtime leftovers kept local after chezmoi migration.
config/dms/
config/pi/
config/tmux/.tmux/plugins/

# Local Pi runtime state
.atl/
.pi-lens/
.pi-cache/

# Superpowers visual brainstorming artifacts
.superpowers/

# Runtime-generated configuration.
# Matugen owns the Kitty theme; Home Manager initializes GTK settings.
config/shared/.config/kitty/current-theme.conf
# LazyVim records local install/news metadata here; the plugin lock stays tracked.
config/shared/.config/nvim/lazyvim.json
config/shared/.config/gtk-4.0/settings.ini
# Hyprland display-targets runtime state.
config/shared/.config/orgm-hypr/display-targets.json
