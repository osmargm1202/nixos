{
  "desktop": {
    "appOverrides": [],
    "appearance": {
      "activeBorder": "#e0563b",
      "activeOpacity": 1,
      "animatedBorder": false,
      "animations": true,
      "blurBrightness": 1,
      "blurContrast": 0.8916,
      "blurEnabled": true,
      "blurIgnoreOpacity": true,
      "blurNewOptimizations": true,
      "blurNoise": 0.01,
      "blurPasses": 1,
      "blurPopups": false,
      "blurSize": 4,
      "blurSpecial": false,
      "blurVibrancy": 0.17,
      "blurVibrancyDarkness": 0,
      "blurXray": false,
      "borderAngleSpeed": 3,
      "borderFollowsPalette": true,
      "borderPartOfWindow": true,
      "borderSize": 0,
      "dimAround": 0.4,
      "dimInactive": false,
      "dimModal": true,
      "dimSpecial": 0.2,
      "dimStrength": 0.5,
      "extendBorderGrab": 15,
      "fullscreenOpacity": 1,
      "gapsIn": 12,
      "gapsOut": 18,
      "gapsWorkspaces": 0,
      "glowColor": "#ee33cc",
      "glowEnabled": false,
      "glowRange": 10,
      "hoverIconOnBorder": true,
      "inactiveBorder": "#313a4d",
      "inactiveOpacity": 0.94,
      "layout": "dwindle",
      "noFocusFallback": false,
      "resizeCorner": 0,
      "resizeOnBorder": true,
      "rounding": 12,
      "roundingPower": 2,
      "shadowColor": "#000000",
      "shadowEnabled": true,
      "shadowPower": 4,
      "shadowRange": 45,
      "shadowScale": 1,
      "shadowSharp": false,
      "snapEnabled": false,
      "windowStyle": "preset",
      "wobblyWindows": false
    },
    "autostart": [
      {
        "command": "kdeconnect-indicator"
      },
      {
        "command": "firefox"
      },
      {
        "command": "sh -lc 'command -v discord \u003e/dev/null 2\u003e\u00261 \u0026\u0026 exec discord --start-minimized || true'"
      },
      {
        "command": "sh -lc 'command -v steam \u003e/dev/null 2\u003e\u00261 \u0026\u0026 exec steam -silent || true'"
      }
    ],
    "cursor": {
      "hideOnKeyPress": false,
      "inactiveTimeout": 0,
      "size": 24,
      "theme": "Bibata-Modern-Ice"
    },
    "env": [],
    "input": {
      "accelProfile": "",
      "clickfinger": false,
      "disableWhileTyping": true,
      "followMouse": 1,
      "kbLayout": "us,latam",
      "kbOptions": "grp:ctrl_space_toggle",
      "kbVariant": "altgr-intl,",
      "leftHanded": false,
      "middleClickPaste": true,
      "middleEmulation": false,
      "mouseNaturalScroll": false,
      "mouseScrollFactor": 1,
      "naturalScroll": false,
      "numlockByDefault": true,
      "repeatDelay": 600,
      "repeatRate": 25,
      "sensitivity": 0,
      "swipeCreateNew": true,
      "swipeDistance": 300,
      "swipeFingers": 3,
      "swipeInvert": true,
      "tapAndDrag": true,
      "tapToClick": true,
      "touchScrollFactor": 1,
      "workspaceSwipe": false
    },
    "keybindRebinds": {
      "SUPER + H": "SUPER + CTRL + ALT + SHIFT + H",
      "SUPER + S": "SUPER + H"
    },
    "keybinds": [
      {
        "action": "exec",
        "keys": "SUPER + H",
        "value": "ryoku-shell stash"
      }
    ],
    "unbinds": [
      "SUPER + H"
    ],
    "windowRules": [
      {
        "action": "columnwidth",
        "class": "(?i)^(firefox|firefox-esr|firefox-bin|org\\.mozilla\\.firefox|chromium|chromium-browser|org\\.chromium\\.Chromium|google-chrome(-stable|-beta|-unstable)?|com\\.google\\.Chrome|brave-browser(-beta|-nightly)?|brave-origin|com\\.brave\\.Browser|opera|vivaldi(-stable)?)$",
        "value": "1"
      },
      {
        "action": "columnwidth",
        "class": "^(chrome-.*\\..*-Default|orgm-webapp-[a-z0-9-]+)$",
        "value": "1"
      },
      {
        "action": "fullscreen",
        "class": "^windows-rdp$",
        "value": ""
      }
    ],
    "windows": {
      "tameMaximizeOnOpen": true
    }
  },
  "wm": {
    "hyprland": {
      "dwindle": {
        "defaultSplitRatio": 1,
        "forceSplit": "follow",
        "preserveSplit": false,
        "smartResizing": true,
        "smartSplit": false,
        "useActiveForSplits": true
      },
      "layerRules": [],
      "master": {
        "mfact": 0.55,
        "newOnTop": false,
        "newStatus": "slave",
        "orientation": "left",
        "smartResizing": true
      },
      "plugins": {
        "dynamicCursors": {
          "enabled": false,
          "magnify": 4,
          "mode": "tilt",
          "shake": true
        },
        "hyprbars": {
          "blur": true,
          "buttons": true,
          "enabled": false,
          "height": 26,
          "textSize": 11
        },
        "hyprfocus": {
          "bounce": 0.95,
          "enabled": false,
          "mode": "flash",
          "opacity": 0.8,
          "slide": 20
        },
        "hyprglass": {
          "blurStrength": 2,
          "brightness": 1,
          "enabled": false,
          "opacity": 1,
          "preset": "clear",
          "theme": "dark",
          "tint": "8899aa22"
        },
        "hyprscrolling": {
          "columnWidth": 0.5,
          "followFocus": true
        },
        "imgborders": {
          "blur": false,
          "enabled": false,
          "image": "",
          "insets": "0,0,0,0",
          "scale": 1,
          "sizes": "8,8,8,8",
          "smooth": true
        },
        "keysounds": {
          "enabled": false,
          "profile": "cherry-mx-brown",
          "release": true,
          "volume": 0.6
        }
      }
    }
  }
}