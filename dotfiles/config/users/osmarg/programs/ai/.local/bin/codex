#!/usr/bin/env bash
set -euo pipefail

# A dedicated backend keeps each tmux pane's conversation discoverable through
# its process tree. A shared daemon inherits the first pane's environment.
tmux_args=()
if [[ -n ${TMUX:-} ]]; then
  case ${1:-} in
    exec|e|review|login|logout|app-server|mcp|mcp-server|completion|sandbox|debug|apply|features|remote-control|agents|queue) ;;
    *) tmux_args=(--no-daemon) ;;
  esac
fi
# Default to no approvals and no sandbox, unless the caller already chose a
# policy: Codex rejects a repeated flag (a tmux restore replays the saved one)
# and refuses the bypass next to an explicit approval or sandbox mode (amux
# launches workers with `-a never --sandbox workspace-write`).
flags=(--dangerously-bypass-approvals-and-sandbox)
for arg in "$@"; do
  case $arg in
    --no-daemon) tmux_args=() ;;
    --dangerously-bypass-approvals-and-sandbox | --yolo | --full-auto | \
      -a | -a?* | --ask-for-approval | --ask-for-approval=* | \
      -s | -s?* | --sandbox | --sandbox=*) flags=() ;;
  esac
done

# Keep stdin attached to the caller; enumerate executables on a separate FD.
while IFS= read -r -u 3 candidate; do
  [[ $candidate -ef $0 ]] && continue
  exec "$candidate" "${flags[@]}" "${tmux_args[@]}" "$@" 3<&-
done 3< <(type -aP codex)

printf '%s\n' 'codex: executable not found outside ~/.local/bin' >&2
exit 127
