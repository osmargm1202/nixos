#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
state_file="$state_dir/game-mode"
lock_file="$state_dir/game-mode.lock"
wallpaper_bin="${HYPR_WALLPAPER_BIN:-$HOME/.local/bin/hypr-wallpaper}"

read_state() {
  if [[ -r "$state_file" ]] && [[ "$(<"$state_file")" == "activated" ]]; then
    printf '%s\n' activated
  else
    printf '%s\n' deactivated
  fi
}

write_state() {
  local state="$1"
  local temporary

  temporary="$(mktemp "$state_file.tmp.XXXXXX")"
  printf '%s\n' "$state" >"$temporary"
  mv "$temporary" "$state_file"
}

refresh_waybar() {
  local pid
  while IFS= read -r pid; do
    kill -s 43 "$pid" 2>/dev/null || true
  done < <(pgrep -u "$(id -u)" -f '(^|/)waybar( |$)' || true)
}

apply_wallpaper_state() {
  case "$1" in
    # Keep the transaction lock in this process, never in wallpaper daemons.
    activated) "$wallpaper_bin" hide 9>&- ;;
    deactivated) "$wallpaper_bin" restore 9>&- ;;
  esac
}

apply_state() {
  local previous="$1"
  local next="$2"

  write_state "$next"
  if ! hyprctl reload || ! apply_wallpaper_state "$next"; then
    write_state "$previous"
    hyprctl reload || true
    apply_wallpaper_state "$previous" || true
    return 1
  fi

  refresh_waybar

  if command -v notify-send >/dev/null 2>&1; then
    if [[ "$next" == activated ]]; then
      notify-send -a "hypr-game-mode" "Modo juego" "Efectos visuales desactivados" >/dev/null 2>&1 || true
    else
      notify-send -a "hypr-game-mode" "Modo juego" "Efectos visuales restaurados" >/dev/null 2>&1 || true
    fi
  fi
}

read_option() {
  local path="$state_dir/game-$1"
  if [[ -f "$path" && -r "$path" ]] && [[ "$(<"$path")" == activated ]]; then
    printf '%s\n' activated
  else
    printf '%s\n' deactivated
  fi
}

write_option() {
  local temporary
  temporary="$(mktemp "$state_dir/game-$1.tmp.XXXXXX")" || return 1
  if ! printf '%s\n' "$2" >"$temporary" || ! mv "$temporary" "$state_dir/game-$1"; then
    rm -f "$temporary"
    return 1
  fi
}

# Subshell releases the lock before a settings menu waits for its next choice.
set_option() (
  local key="$1" action="$2" previous next
  case "$key:$action" in
    vrr:on|vrr:off|vrr:toggle|tearing:on|tearing:off|tearing:toggle) ;;
    *) return 64 ;;
  esac
  exec 9>"$lock_file" || return 1
  flock 9 || return 1
  previous="$(read_option "$key")"
  case "$action" in
    on) next=activated ;;
    off) next=deactivated ;;
    toggle) [[ "$previous" == activated ]] && next=deactivated || next=activated ;;
  esac
  write_option "$key" "$next" || return 1
  # Saving an opt-in never enables Game Mode or changes the wallpaper.
  if [[ "$(read_state)" == activated ]] && ! hyprctl reload; then
    write_option "$key" "$previous" || return 1
    hyprctl reload || true
    return 1
  fi
)

options_json() {
  local vrr=false tearing=false
  [[ "$(read_option vrr)" == activated ]] && vrr=true
  [[ "$(read_option tearing)" == activated ]] && tearing=true
  printf '{"vrr":%s,"tearing":%s}\n' "$vrr" "$tearing"
}

settings_menu() {
  local choice code vrr tearing
  while true; do
    vrr=apagado; tearing=apagado
    [[ "$(read_option vrr)" == activated ]] && vrr=activado
    [[ "$(read_option tearing)" == activated ]] && tearing=activado
    if choice="$(printf '%s\n' "VRR fullscreen: $vrr" "Tearing: $tearing" "Volver" |
      "${ORGM_ROFI:-$HOME/.local/bin/orgm-rofi}" --compositor hyprland --lines 3 \
        -dmenu -i -no-custom -only-match -format i -p "Opciones de juegos" \
        -mesg "Solo durante Modo juego. VRR requiere pantalla compatible; tearing puede producir cortes.")"; then
      case "$choice" in
        0) set_option vrr toggle || return $? ;;
        1) set_option tearing toggle || return $? ;;
        2) return 0 ;;
        *) return 64 ;;
      esac
    else
      code=$?
      [[ "$code" == 1 ]] && return 0
      return "$code"
    fi
  done
}

mkdir -p "$state_dir"

case "${1:-}" in
  vrr|tearing)
    [[ "$#" == 2 ]] || exit 64
    set_option "$1" "$2"
    ;;
  options)
    options_json
    ;;
  settings)
    settings_menu
    ;;
  toggle|on|off)
    exec 9>"$lock_file"
    flock 9
    previous="$(read_state)"
    case "${1:-}" in
      toggle) [[ "$previous" == activated ]] && next=deactivated || next=activated ;;
      on) next=activated ;;
      off) next=deactivated ;;
    esac
    apply_state "$previous" "$next"
    ;;
  sync)
    exec 9>"$lock_file"
    flock 9
    apply_wallpaper_state "$(read_state)"
    ;;
  status)
    read_state
    ;;
  waybar)
    if [[ "$(read_state)" == activated ]]; then
      printf '%s\n' '{"text":"󰊴","class":"activated","tooltip":"Modo juego: efectos visuales desactivados"}'
    else
      printf '%s\n' '{"text":"󰊴","class":"deactivated","tooltip":"Modo juego: efectos visuales normales"}'
    fi
    ;;
  *)
    printf 'Usage: %s {toggle|on|off|status|waybar|sync|options|settings|vrr on/off/toggle|tearing on/off/toggle}\n' "${0##*/}" >&2
    exit 64
    ;;
esac
