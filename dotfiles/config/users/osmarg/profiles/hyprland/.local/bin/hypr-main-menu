#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

bin_dir="${HYPR_BIN_DIR:-$HOME/.local/bin}"

menu_items=(
  '󰀻 Apps'
  '󰆧 Programas y ventanas'
  '󰖟 Set profile wallpaper'
)
if [[ -d "${HYPR_SHADER_ROOT:-/etc/hyprwindowshade-shaders/open}" ]]; then
  menu_items+=('󰎔 Shaders de apertura')
fi
menu_items+=('󰒓 Tools' '󰞅 Symbols and emoji' '󰖩 Devices' '󰒓 System' '󰌌 Help' '󰐥 Power' '󰅖 Quit')
choice="$(printf '%s\n' "${menu_items[@]}" | hypr_rofi_dmenu 'Hyprland' || true)"

case "$choice" in
  *'Apps') exec "$bin_dir/hypr-apps-menu" ;;
  *'Programas y ventanas') exec "$bin_dir/hypr-config-editor" "lua/windows-workspaces.lua" ;;
  *'Set profile wallpaper') exec orgm-visual-profile random-wallpaper ;;
  *'Shaders de apertura') exec "$bin_dir/hypr-shader-menu" ;;
  *'Tools') exec "$bin_dir/hypr-tools-menu" ;;
  *'Symbols and emoji') exec rofi-symbols ;;
  *'Devices') exec "$bin_dir/hypr-devices-menu" ;;
  *'System') exec "$bin_dir/hypr-system-menu" ;;
  *'Help') exec "$bin_dir/hypr-help-menu" ;;
  *'Power') exec "$bin_dir/hypr-power-menu" ;;
  *'Quit'|'') exit 0 ;;
esac
