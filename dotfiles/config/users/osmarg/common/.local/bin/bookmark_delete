#!/usr/bin/env bash
set -euo pipefail

menu_command=rofi
desktop="${XDG_CURRENT_DESKTOP:-}"
case "${desktop,,}" in *gnome*) menu_command=orgm-menu ;; esac

bookmarks_file=.bookmarks
[[ -r $bookmarks_file ]] || exit 0
bookmark=$("$menu_command" -dmenu -p 'delete bookmark' < "$bookmarks_file") || exit 0
[[ -n $bookmark ]] || exit 0

temporary=$(mktemp "${TMPDIR:-/tmp}/bookmark.XXXXXX")
trap 'rm -f "$temporary"' EXIT
while IFS= read -r line || [[ -n $line ]]; do
  [[ $line == "$bookmark" ]] || printf '%s\n' "$line" >> "$temporary"
done < "$bookmarks_file"
mv "$temporary" "$bookmarks_file"
trap - EXIT
notify-send Bookmarks "Bookmark '$bookmark' was deleted" -t 2000
