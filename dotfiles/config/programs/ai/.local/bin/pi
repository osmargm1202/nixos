#!/usr/bin/env bash
set -euo pipefail

# Desktop launchers do not run the interactive shell that adds these paths.
export PATH="$PATH:${BUN_INSTALL:-$HOME/.bun}/bin:${NPM_CONFIG_PREFIX:-$HOME/.npm-global}/bin:${FNM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fnm}/aliases/default/bin"

# Keep the terminal and stdin intact while adding tmux's session recorder.
while IFS= read -r -u 3 candidate; do
  [[ $candidate -ef $0 ]] && continue
  if [[ -n ${TMUX:-} ]] && command -v tmux-agent-resume >/dev/null 2>&1; then
    exec tmux-agent-resume launch pi "$candidate" "$@" 3<&-
  fi
  exec "$candidate" "$@" 3<&-
done 3< <(type -aP pi)

printf '%s\n' 'pi: native executable not found on PATH' >&2
exit 127
