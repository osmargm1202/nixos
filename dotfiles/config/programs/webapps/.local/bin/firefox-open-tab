#!/usr/bin/env bash
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Firefox" "$1" 2>/dev/null || true
}

usage() {
  printf 'Usage: %s [--new | --new-tab] [--prompt] URL | %s --focus | %s --restore-or-focus\n' "${0##*/}" "${0##*/}" "${0##*/}" >&2
}

fail() {
  notify "$1"
  usage
  exit 2
}

normalize_url() {
  local value="$1"

  [[ -n "$value" && "$value" != *[[:space:]]* ]] || return 1
  case "$value" in
    http://?*|https://?*|about:?*)
      printf '%s\n' "$value"
      return
      ;;
  esac

  if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^\[[[:xdigit:]:]+\](:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^localhost(:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^[^./:]+:[0-9]+(/.*)?$ ]]; then
    printf 'http://%s\n' "$value"
  elif [[ "$value" =~ ^[[:alpha:]][[:alnum:]+.-]*: ]]; then
    printf '%s\n' "$value"
  elif [[ "$value" == *.* ]]; then
    printf 'https://%s\n' "$value"
  else
    printf 'https://%s.com\n' "$value"
  fi
}

prompt_url() {
  command -v rofi >/dev/null 2>&1 || {
    notify "Rofi is not installed"
    return 1
  }
  rofi -dmenu -i -p "Abrir web"
}

focus_firefox() {
  local clients address tree id

  case "${XDG_CURRENT_DESKTOP:-}" in
    *Hyprland*)
      command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 2
      clients="$(hyprctl -j clients)" || return 2
      jq -e 'type == "array"' >/dev/null <<<"$clients" || return 2
      address="$(
        jq -r '
          [
            .[]
            | select(
                ((.class // "") | test("^(firefox|navigator)$"; "i"))
                or ((.initialClass // "") | test("^(firefox|navigator)$"; "i"))
              )
            | select((.address | type) == "string" and (.address | length) > 0)
            | { address, focusHistoryID }
          ]
          | sort_by(
              if ((.focusHistoryID | type) == "number" and .focusHistoryID >= 0)
              then .focusHistoryID
              else 1e30
              end
            )
          | .[0].address // empty
        ' <<<"$clients"
      )" || return 2
      [[ -n "$address" ]] || return 1
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" || return 2
      ;;
    *i3*)
      command -v i3-msg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 2
      tree="$(i3-msg -t get_tree)" || return 2
      jq -e 'type == "object"' >/dev/null <<<"$tree" || return 2
      id="$(
        jq -r '
          def ordered_children:
            [(.nodes[]?, .floating_nodes[]?)] as $children
            | (.focus // []) as $focus
            | [
                $focus[] as $child_id
                | $children[]
                | select(.id == $child_id)
              ]
              + [
                $children[] as $child
                | select($focus | index($child.id) | not)
                | $child
              ];
          def descendants:
            ordered_children[] as $child
            | $child, ($child | descendants);
          def firefox_window:
            ((.window_properties.class // "") | test("^(firefox|navigator)$"; "i"))
            or ((.window_properties.instance // "") | test("^(firefox|navigator)$"; "i"));
          first(
            . | descendants
            | select(
                ((.nodes // []) | length == 0)
                and ((.floating_nodes // []) | length == 0)
                and firefox_window
              )
            | .id
          ) // empty
        ' <<<"$tree"
      )" || return 2
      [[ -n "$id" ]] || return 1
      [[ "$id" =~ ^[0-9]+$ ]] || return 2
      i3-msg "[con_id=$id] focus" || return 2
      ;;
    *labwc*)
      command -v wlrctl >/dev/null 2>&1 || return 2
      if wlrctl toplevel find app_id:firefox app_id:org.mozilla.firefox >/dev/null 2>&1; then
        :
      else
        find_status=$?
        [[ "$find_status" == 1 ]] && return 1
        return 2
      fi
      wlrctl toplevel focus app_id:firefox app_id:org.mozilla.firefox || return 2
      ;;
    *)
      return 2
      ;;
  esac
}
firefox_process_is_running() {
  local status

  while read -r status; do
    [[ -n "$status" && "$status" != Z* ]] && return 0
  done < <(ps -C firefox -o stat= 2>/dev/null || true)
  return 1
}


focus_after_opening_tab() {
  (
    # Firefox receives --new-tab asynchronously.  Let it map/raise the browser
    # window before asking the compositor to focus it.
    sleep 0.1
    focus_firefox >/dev/null 2>&1 || notify "The Firefox window could not be focused"
  ) &
}

new_window=false
new_tab=false
prompt=false
focus_only=false
restore_or_focus=false
input=""
while (($#)); do
  case "$1" in
    --new)
      new_window=true
      ;;
    --new-tab)
      new_tab=true
      ;;
    --prompt)
      prompt=true
      ;;
    --focus)
      focus_only=true
      ;;
    --restore-or-focus)
      restore_or_focus=true
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || fail "Specify exactly one URL"
      input="$1"
      break
      ;;
    -*)
      fail "Unknown option: $1"
      ;;
    *)
      [[ -z "$input" ]] || fail "Specify exactly one URL"
      input="$1"
      ;;
  esac
  shift
done

if "$focus_only"; then
  [[ "$new_window" == false && "$new_tab" == false && "$prompt" == false && "$restore_or_focus" == false && -z "$input" ]] ||
    fail "--focus cannot be combined with a URL or creation options"
  focus_firefox >/dev/null 2>&1 || {
    notify "No existing Firefox window could be focused"
    exit 1
  }
  exit 0
fi

if "$restore_or_focus"; then
  [[ "$new_window" == false && "$new_tab" == false && "$prompt" == false && -z "$input" ]] ||
    fail "--restore-or-focus cannot be combined with a URL or other options"
  if focus_firefox >/dev/null 2>&1; then
    command -v firefox >/dev/null 2>&1 || {
      notify "Firefox is not installed"
      exit 1
    }
    firefox --new-tab about:blank >/dev/null 2>&1 &
    exit 0
  else
    focus_status=$?
  fi
  case "$focus_status" in
    1)
      command -v firefox >/dev/null 2>&1 || {
        notify "Firefox is not installed"
        exit 1
      }
      firefox >/dev/null 2>&1 &
      exit 0
      ;;
    2)
      if firefox_process_is_running; then
        notify "Firefox is already running but no window could be focused"
        exit 1
      fi
      command -v firefox >/dev/null 2>&1 || {
        notify "Firefox is not installed"
        exit 1
      }
      firefox >/dev/null 2>&1 &
      exit 0
      ;;
    *)
      notify "Firefox focus failed"
      exit 1
      ;;
  esac
fi

if "$new_window" && "$new_tab"; then
  fail "--new and --new-tab cannot be combined"
fi

if "$prompt"; then
  [[ -z "$input" ]] || fail "--prompt cannot be combined with a URL"
  input="$(prompt_url || true)"
  [[ -n "$input" ]] || exit 0
fi

if { "$new_window" || "$new_tab"; } && [[ "$prompt" == false && -z "$input" ]]; then
  input="about:blank"
fi

[[ -n "$input" ]] || fail "A URL is required"
url="$(normalize_url "$input")" || {
  notify "URL inválida"
  exit 1
}

if "$new_window"; then
  command -v firefox >/dev/null 2>&1 || {
    notify "Firefox is not installed"
    exit 1
  }
  firefox --new-window "$url" >/dev/null 2>&1 &
  exit 0
fi

if "$new_tab"; then
  command -v firefox >/dev/null 2>&1 || {
    notify "Firefox is not installed"
    exit 1
  }
  firefox --new-tab "$url" >/dev/null 2>&1 &
  exit 0
fi

if command -v windows-manager-linux-orgm-tab >/dev/null 2>&1 &&
   windows-manager-linux-orgm-tab "$url" 2>/dev/null; then
  # Native messaging selects the tab asynchronously; focus Firefox after that
  # operation reaches the compositor.
  focus_after_opening_tab
  exit 0
fi

command -v firefox >/dev/null 2>&1 || {
  notify "Firefox is not installed"
  exit 1
}
firefox --new-tab "$url" >/dev/null 2>&1 &
focus_after_opening_tab
