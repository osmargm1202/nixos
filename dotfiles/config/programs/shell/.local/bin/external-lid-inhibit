#!/usr/bin/env bash
set -euo pipefail

drm_root="${EXTERNAL_LID_INHIBIT_DRM_ROOT:-/sys/class/drm}"
inhibitor=''
interval="${EXTERNAL_LID_INHIBIT_INTERVAL:-5}"

external_display_connected() {
  local status connector

  for status in "$drm_root"/card*-*/status; do
    [[ -r "$status" ]] || continue
    connector="${status%/status}"
    connector="${connector##*/}"

    case "$connector" in
      card*-eDP-*|card*-LVDS-*|card*-DSI-*) continue ;;
    esac

    [[ "$(<"$status")" == connected ]] && return 0
  done

  return 1
}

start() {
  [[ -n "$inhibitor" ]] && kill -0 "$inhibitor" 2>/dev/null && return
  setsid systemd-inhibit --what=handle-lid-switch --mode=block \
    --why='Laptop has a connected external display' sleep infinity >/dev/null 2>&1 &
  inhibitor=$!
}

stop() {
  [[ -z "$inhibitor" ]] && return
  kill -- "-$inhibitor" 2>/dev/null || true
  wait "$inhibitor" 2>/dev/null || true
  inhibitor=''
}

trap 'stop' EXIT
trap 'stop; exit 0' INT TERM
while :; do
  if external_display_connected; then start; else stop; fi
  sleep "$interval"
done
