[
  {
    "name": "top_bar",
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 5,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
      "custom/menu",
      "custom/ws_1",
      "custom/ws_2",
      "custom/ws_3",
      "custom/ws_4",
      "custom/ws_5",
      "custom/ws_6",
      "custom/ws_7",
      "custom/ws_8",
      "custom/ws_9",
      "custom/ws_10",
      "custom/ws_special",
      "backlight",
      "battery",
      "pulseaudio",
      "pulseaudio#microphone",
      "idle_inhibitor",
      "custom/kbd_layout",
      "custom/wallpaper",
      "custom/keybindings_help"
    ],
    "modules-center": [
      "custom/day_month",
      "custom/time",
      "custom/date"
    ],
    "modules-right": [
      "hyprland/window",
      "mpris",
      "custom/power",
      "tray"
    ],
    "custom/menu": {
      "format": "",
      "tooltip": true,
      "tooltip-format": "Abrir menú principal",
      "on-click": "hypr-main-menu"
    },
    "custom/power": {
      "format": "󰐥",
      "tooltip": true,
      "tooltip-format": "Menú de energía",
      "on-click": "hypr-power-menu"
    },
    "custom/ws_1": {
      "exec": "hypr-workspace-button status 1",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 1"
    },
    "custom/ws_2": {
      "exec": "hypr-workspace-button status 2",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 2"
    },
    "custom/ws_3": {
      "exec": "hypr-workspace-button status 3",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 3"
    },
    "custom/ws_4": {
      "exec": "hypr-workspace-button status 4",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 4"
    },
    "custom/ws_5": {
      "exec": "hypr-workspace-button status 5",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 5"
    },
    "custom/ws_6": {
      "exec": "hypr-workspace-button status 6",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 6"
    },
    "custom/ws_7": {
      "exec": "hypr-workspace-button status 7",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 7"
    },
    "custom/ws_8": {
      "exec": "hypr-workspace-button status 8",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 8"
    },
    "custom/ws_9": {
      "exec": "hypr-workspace-button status 9",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 9"
    },
    "custom/ws_10": {
      "exec": "hypr-workspace-button status 10",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true,
      "on-click": "hypr-workspace-button click 10"
    },
    "custom/ws_special": {
      "format": "S",
      "tooltip": true,
      "tooltip-format": "Workspace especial",
      "on-click": "hyprctl dispatch togglespecialworkspace magic"
    },
    "backlight": {
      "format": "{icon} {percent}%",
      "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}% ",
      "format-plugged": "󰚥 {capacity}%",
      "format-full": "󰁹 {capacity}%",
      "tooltip-format": "{capacity}% {timeTo} {power}W",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "󰝟",
      "format-icons": {
        "default": ["", "", ""]
      },
      "on-click": "pamixer -t",
      "on-click-middle": "kitty -e pulsemixer",
      "on-click-right": "kitty -e pulsemixer",
      "max-volume": 150
    },
    "pulseaudio#microphone": {
      "target": "source",
      "format": "{format_source}",
      "format-source": "󰍬",
      "format-source-muted": "󰍭",
      "on-click": "pamixer --default-source -t",
      "on-click-middle": "kitty -e pulsemixer",
      "on-click-right": "kitty -e pulsemixer",
      "max-volume": 150
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "tooltip": true,
      "tooltip-format": "Caffeine: mantener pantalla activa",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰾪"
      }
    },
    "custom/kbd_layout": {
      "exec": "~/.config/waybar-hypr/kbd-layout.sh",
      "interval": 1,
      "tooltip": false,
      "on-click": "~/.local/bin/kbd-layout-next"
    },
    "custom/wallpaper": {
      "format": "",
      "tooltip": true,
      "tooltip-format": "Fondo aleatorio",
      "on-click": "hypr-wallpaper random"
    },
    "custom/keybindings_help": {
      "format": "?",
      "tooltip": true,
      "tooltip-format": "Atajos Hyprland",
      "on-click": "hypr-keybindings-help"
    },
    "custom/day_month": {
      "exec": "waybar-day-month-es",
      "interval": 60,
      "tooltip": false
    },
    "custom/time": {
      "exec": "waybar-time-ampm",
      "interval": 1,
      "tooltip": false
    },
    "custom/date": {
      "exec": "waybar-date-es",
      "interval": 60,
      "tooltip": false
    },
    "hyprland/window": {
      "format": "{}",
      "max-length": 50,
      "separate-outputs": true
    },
    "mpris": {
      "format": " 󰐊",
      "format-paused": " 󰐉",
      "format-stopped": "",
      "tooltip-format": "{dynamic}",
      "max-length": 0,
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "on-click-middle": "playerctl previous"
    },
    "tray": {
      "icon-size": 21,
      "spacing": 10
    }
  }
]
