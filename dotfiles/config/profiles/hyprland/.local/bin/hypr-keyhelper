#!/bin/sh
set -eu

case "${1:-toggle}" in
  init|toggle)
    # Compatibility shim: keep command surface for older binds/configs.
    # Keep lightweight: open the rofi keybinding menu directly.
    exec hypr-keybindings-help "$@"
    ;;
  *)
    echo "usage: hypr-keyhelper [init|toggle]" >&2
    exit 2
    ;;
esac
