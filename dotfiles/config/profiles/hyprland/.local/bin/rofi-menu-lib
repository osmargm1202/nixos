#!/usr/bin/env bash

# Shared Rofi theme selection for graphical menus outside a profile helper.
# Source this file; do not execute it.

rofi_menu_theme() {
  case "${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}" in
    *i3*) printf '%s\n' "$HOME/.config/rofi/i3-menu.rasi" ;;
    *) printf '%s\n' "$HOME/.config/rofi-sway/sway-launcher.rasi" ;;
  esac
}

rofi_menu() {
  case "${XDG_CURRENT_DESKTOP:-}" in
    *i3*) rofi -theme "$(rofi_menu_theme)" "$@" ;;
    *) "${ORGM_ROFI:-$HOME/.local/bin/orgm-rofi}" --compositor hyprland "$@" ;;
  esac
}
