#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

# Active files are store-backed. Edit the checkout, then rebuild explicitly.
hypr_root="${HYPR_CONFIG_EDITOR_ROOT:-$HOME/Hobby/nixos/dotfiles/config/profiles/hyprland/.config/hypr}"

notify() {
  notify-send "Hypr config" "$1" 2>/dev/null || true
}

if [ ! -d "$hypr_root" ]; then
  notify "No existe la fuente editable $hypr_root; prepara un checkout o define HYPR_CONFIG_EDITOR_ROOT"
  exit 1
fi

selected="${1:-}"
if [[ -z "$selected" ]]; then
  selected="$(
    cd "$hypr_root"
    find . -type f -name '*.lua' \
      -printf '%P\n' | sort | hypr_rofi_dmenu 'Hypr Lua config' 18 760px
  )" || exit 0
fi

[ -n "$selected" ] || exit 0

case "$selected" in
  /*|*'..'*|'')
    notify "Selección inválida: $selected"
    exit 1
    ;;
esac

file="$hypr_root/$selected"
if [ ! -f "$file" ]; then
  notify "No existe $file"
  exit 1
fi

action="$(printf '%s\n' 'Editar con nvim' 'Abrir con app por defecto' 'Cancelar' | hypr_rofi_dmenu 'Abrir archivo' 3 520px)" || exit 0

case "$action" in
  *'nvim')
    kitty --class hypr-config-editor -e nvim -- "$file"
    ;;
  *'defecto')
    xdg-open "$file"
    ;;
  *)
    exit 0
    ;;
esac
