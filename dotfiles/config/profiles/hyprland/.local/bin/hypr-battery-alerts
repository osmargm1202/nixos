#!/usr/bin/env bash
set -euo pipefail

interval="${HYPR_BATTERY_ALERT_INTERVAL:-60}"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-battery-alerts/state"
ppctl="${HYPR_BATTERY_ALERT_PPCTL:-powerprofilesctl}"

battery_path() {
  for path in /sys/class/power_supply/BAT*; do
    [ -d "$path" ] || continue
    [ -r "$path/capacity" ] || continue
    [ -r "$path/status" ] || continue
    printf '%s\n' "$path"
    return 0
  done
  return 1
}

read_snapshot() {
  local path
  path="$(battery_path)" || return 1
  capacity="$(cat "$path/capacity")"
  status="$(cat "$path/status")"
}

sent_already() {
  local mark="$1"
  [ -f "$state_file" ] || return 1
  grep -qx "$mark" "$state_file"
}

mark_sent() {
  local mark="$1"
  mkdir -p "$(dirname "$state_file")"
  touch "$state_file"
  sent_already "$mark" || printf '%s\n' "$mark" >>"$state_file"
}

clear_marks() {
  local prefix="$1"
  [ -f "$state_file" ] || return 0
  grep -v "^${prefix}" "$state_file" >"$state_file.tmp" || true
  mv "$state_file.tmp" "$state_file"
}

reset_sent() {
  rm -f "$state_file"
}

notify_alert() {
  local urgency="$1"
  local title="$2"
  local body="$3"
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a orgm-battery -u "$urgency" \
    -h string:x-canonical-private-synchronous:orgm-battery \
    "$title" "$body" >/dev/null 2>&1 || true
}

set_profile() {
  command -v "$ppctl" >/dev/null 2>&1 || return 0
  "$ppctl" set "$1" >/dev/null 2>&1 || true
}

check_once() {
  capacity="${HYPR_BATTERY_ALERT_CAPACITY:-${capacity:-}}"
  status="${HYPR_BATTERY_ALERT_STATUS:-${status:-}}"

  if [ -z "${capacity:-}" ] || [ -z "${status:-}" ]; then
    read_snapshot || return 0
  fi

  case "$status" in
    Discharging)
      # Nuevo ciclo de descarga: re-arma los umbrales de carga.
      clear_marks charge-

      if [ "$capacity" -le 10 ] && ! sent_already act-saver; then
        set_profile power-saver
        mark_sent act-saver
      fi

      if [ "$capacity" -le 5 ]; then
        if ! sent_already notif-5; then
          notify_alert critical "✖ BATERÍA CRÍTICA" "🔴 󰂃 ${capacity}%"
          mark_sent notif-5
        fi
      elif [ "$capacity" -le 10 ]; then
        if ! sent_already notif-10; then
          notify_alert critical "Batería al 10%" "󱡴 Modo ahorro activado · ${capacity}%"
          mark_sent notif-10
        fi
      elif [ "$capacity" -le 20 ]; then
        if ! sent_already notif-20; then
          notify_alert normal "Batería baja" "󰁻 ${capacity}%"
          mark_sent notif-20
        fi
      elif [ "$capacity" -le 30 ]; then
        if ! sent_already notif-30; then
          notify_alert normal "Batería al 30%" "󰁽 ${capacity}%"
          mark_sent notif-30
        fi
      fi
      ;;
    *)
      # Con AC: re-arma notificaciones y ahorro para la próxima descarga.
      clear_marks notif-
      clear_marks act-

      if [ "$capacity" -ge 90 ]; then
        if ! sent_already charge-90; then
          set_profile performance
          mark_sent charge-90
        fi
      elif [ "$capacity" -ge 50 ]; then
        if ! sent_already charge-50; then
          set_profile balanced
          mark_sent charge-50
        fi
      fi
      ;;
  esac
}

case "${1:-daemon}" in
  once)
    check_once
    ;;
  daemon)
    while :; do
      check_once || true
      sleep "$interval"
    done
    ;;
  reset)
    reset_sent
    ;;
  *)
    echo "Usage: ${0##*/} [once|daemon|reset]" >&2
    exit 2
    ;;
esac
