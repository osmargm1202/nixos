#!/usr/bin/env bash
set -euo pipefail

interval="${SWAY_WALLPAPER_INTERVAL:-1800}"
current_file="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-random-wallpaper.current"
daemon_pid_file="${XDG_RUNTIME_DIR:-/tmp}/hypr-random-wallpaper.daemon.pid"
wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"

autofind_wallpaper() {
  [ -d "$wallpaper_dir" ] || return 1

  find "$wallpaper_dir" -type f \
    -iname '*.jpg' -o \
    -iname '*.jpeg' -o \
    -iname '*.png' -o \
    -iname '*.webp' \
    | shuf -n 1
}

pick_wallpaper() {
  autofind_wallpaper
}

store_current_wallpaper() {
  local wallpaper="$1"
  mkdir -p "$(dirname "$current_file")"
  printf '%s\n' "$wallpaper" >"$current_file"
}

set_wallpaper() {
  local wallpaper="$1"
  local monitor="${2-}"

  [ -f "$wallpaper" ] || return 1
  store_current_wallpaper "$wallpaper"

  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl hyprpaper preload "$wallpaper" >/dev/null 2>&1 || true
    if [ -n "${monitor-}" ]; then
      hyprctl hyprpaper wallpaper "$monitor,$wallpaper" >/dev/null 2>&1 || \
        hyprctl dispatch exec "hyprctl hyprpaper wallpaper $monitor,$wallpaper" >/dev/null 2>&1 || \
        true
    else
      hyprctl hyprpaper wallpaper ",$wallpaper" >/dev/null 2>&1 || \
        hyprctl dispatch exec "hyprctl hyprpaper wallpaper ,$wallpaper" >/dev/null 2>&1 || \
        hyprctl keyword misc:background_color "rgba(000000ff)" >/dev/null 2>&1 || true
    fi
    return 0
  fi

  return 1
}

waytrogen_current_path() {
  if ! command -v waytrogen >/dev/null 2>&1; then
    return 1
  fi

  local payload
  payload="$(waytrogen --list-current-wallpapers 2>/dev/null || true)"
  [ -n "$payload" ] || return 1

  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$payload" | jq -r '.path // empty' 2>/dev/null
  else
    printf '%s\n' "$payload" | sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
  fi
}

restore_wallpaper() {
  if command -v waytrogen >/dev/null 2>&1; then
    if waytrogen --restore >/dev/null 2>&1; then
      local current
      current="$(waytrogen_current_path || true)"
      if [ -n "$current" ] && [ -f "$current" ]; then
        set_wallpaper "$current" >/dev/null 2>&1 || true
        return 0
      fi
    fi
  fi

  if [ -f "$current_file" ]; then
    local wallpaper
    wallpaper="$(cat "$current_file" 2>/dev/null || true)"
    if [ -n "$wallpaper" ] && [ -f "$wallpaper" ]; then
      set_wallpaper "$wallpaper" >/dev/null 2>&1 || true
    fi
  fi
}

next_wallpaper() {
  local wallpaper

  if command -v waytrogen >/dev/null 2>&1; then
    if waytrogen --random >/dev/null 2>&1; then
      wallpaper="$(waytrogen_current_path || true)"
      if [ -n "$wallpaper" ] && [ -f "$wallpaper" ]; then
        set_wallpaper "$wallpaper"
        return 0
      fi
    fi
  fi

  wallpaper="$(pick_wallpaper)" || {
    echo "hypr-random-wallpaper: no wallpapers found in $wallpaper_dir" >&2
    return 1
  }

  set_wallpaper "$wallpaper"
}

is_own_daemon_pid() {
  local pid="$1"
  local args

  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac

  kill -0 "$pid" 2>/dev/null || return 1
  args="$(ps -p "$pid" -o args= 2>/dev/null)" || return 1

  case "$args" in
    *hypr-random-wallpaper*|*"$0"*) return 0 ;;
    *) return 1 ;;
  esac
}

run_daemon() {
  mkdir -p "$(dirname "$daemon_pid_file")"
  if [ -f "$daemon_pid_file" ]; then
    local old_pid
    old_pid="$(cat "$daemon_pid_file")"
    if [ "$old_pid" != "$$" ] && is_own_daemon_pid "$old_pid"; then
      kill "$old_pid" 2>/dev/null || true
    fi
    rm -f "$daemon_pid_file"
  fi
  printf '%s\n' "$$" >"$daemon_pid_file"
  trap 'rm -f "$daemon_pid_file"' EXIT INT TERM

  while :; do
    next_wallpaper || true
    sleep "$interval"
  done
}

stop_daemon() {
  [ -f "$daemon_pid_file" ] || return 0
  local pid
  pid="$(cat "$daemon_pid_file")"
  if is_own_daemon_pid "$pid"; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$daemon_pid_file"
}

set_wallpaper_from_args() {
  local wallpaper=""
  local monitor=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --monitor)
        shift
        monitor="${1-}"
        ;;
      --)
        shift
        ;;
      *)
        if [ -z "$wallpaper" ]; then
          wallpaper="$1"
        fi
        ;;
    esac
    shift || true
  done

  if [ -z "$wallpaper" ]; then
    echo "Usage: ${0##*/} set PATH [--monitor NAME]" >&2
    return 2
  fi

  set_wallpaper "$wallpaper" "$monitor"
}

print_usage() {
  cat <<EOF
Usage: ${0##*/} [restore|next|random|random-static|random-video|set|set-static|set-video PATH [--monitor NAME]|daemon|stop]
EOF
}

case "${1:-daemon}" in
  next|random|random-static|random-video)
    next_wallpaper
    ;;
  restore)
    restore_wallpaper
    ;;
  daemon)
    run_daemon
    ;;
  stop)
    stop_daemon
    ;;
  set|set-static|set-video)
    shift
    set_wallpaper_from_args "$@"
    ;;
  *)
    print_usage >&2
    exit 2
    ;;
esac