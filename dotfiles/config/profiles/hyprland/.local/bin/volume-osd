#!/bin/sh
set -eu

step="3"
limit="150"

case "${1:-}" in
  up|down|mute) ;;
  *) echo "usage: sway-volume-osd up|down|mute" >&2; exit 2 ;;
esac

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
if command -v qs >/dev/null 2>&1; then
  result=$(qs --path "$config_root/quickshell/orgm-wallpapers/daemon.qml" ipc call osd adjust output "$1" 2>/dev/null) || result=''
  [ "$result" != "ok" ] || exit 0
fi

# Keep hardware volume controls working during a service restart.
case "${1:-}" in
  up) pamixer --allow-boost --set-limit "$limit" -i "$step" ;;
  down) pamixer --allow-boost --set-limit "$limit" -d "$step" ;;
  mute) pamixer -t ;;
esac

vol=$(pamixer --get-volume)
muted=$(pamixer --get-mute)
if command -v qs >/dev/null 2>&1; then
  qs --path "$config_root/quickshell/orgm-wallpapers/daemon.qml" ipc call osd display output "$vol" "$muted" >/dev/null 2>&1 || true
fi
