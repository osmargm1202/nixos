#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

choice="$(printf '%s\n' \
  '󰀻 App launcher' \
  '󰆍 Kitty' \
  '󰖟 Firefox new window' \
  '󰠮 Obsidian' \
  '󰅖 Cancel' | hypr_rofi_dmenu 'Apps' || true)"

case "$choice" in
  *'App launcher') hypr_rofi_drun ;;
  *'Kitty') exec kitty ;;
  *'Firefox new window') exec hypr-firefox-new-window ;;
  *'Obsidian') exec hypr-obsidian-open-or-focus ;;
  *) exec hypr-main-menu ;;
esac
