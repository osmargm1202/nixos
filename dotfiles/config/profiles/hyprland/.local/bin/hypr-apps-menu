#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

browser_name=Firefox
command -v orgm-browser >/dev/null 2>&1 && browser_name='Brave Origin'
choice="$(printf '%s\n' \
  '󰀻 App launcher' \
  '󰆍 Kitty' \
  "󰖟 $browser_name" \
  '󰅖 Cancel' | hypr_rofi_dmenu 'Apps' || true)"

case "$choice" in
  *'App launcher') hypr_rofi_drun ;;
  *'Kitty') exec kitty ;;
  *'Firefox'|*'Brave Origin') exec firefox-open-tab --restore-or-focus ;;
  *) exec hypr-main-menu ;;
esac
