#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

choice="$(printf '%s\n' \
  '󰍹 Displays' \
  '󰖩 WiFi' \
  '󰂯 Bluetooth' \
  '󰕾 Audio mixer' \
  '󰅖 Cancel' | hypr_rofi_dmenu 'Devices' || true)"

case "$choice" in
  *'Displays') exec nwg-displays ;;
  *'WiFi') exec kitty -e nmtui ;;
  *'Bluetooth') exec kitty -e bluetui ;;
  *'Audio mixer') exec kitty -e pulsemixer ;;
  *) exec hypr-main-menu ;;
esac
