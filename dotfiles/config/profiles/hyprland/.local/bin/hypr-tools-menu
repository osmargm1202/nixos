#!/usr/bin/env bash
set -euo pipefail

lib="${HYPR_ROFI_LIB:-$HOME/.local/bin/hypr-rofi-lib}"
# shellcheck disable=SC1090
. "$lib"

choice="$(printf '%s\n' \
  '󰆍 Terminal' \
  '󰉋 Files' \
  '󰍉 Search files' \
  ' Clipboard' \
  ' Hypr config' \
  '󰃭 Calculator' \
  '󰅖 Cancel' | hypr_rofi_dmenu 'Tools' || true)"

case "$choice" in
  *'Terminal') exec kitty ;;
  *'Files') exec nautilus ;;
  *'Search files') exec hypr-rofi-open-file ;;
  *'Clipboard') exec hypr-rofi-clipboard ;;
  *'Hypr config') exec hypr-config-editor ;;
  *'Calculator') exec hypr-rofi-calc ;;
  *) exec hypr-main-menu ;;
esac
