#!/usr/bin/env bash
set -euo pipefail

# StatusNotifier clients need the graphical session variables in D-Bus before
# they connect, otherwise Waybar's tray cannot discover them at login.
hypr-session-import-env
systemctl --user start nixos-fake-graphical-session.target || true

nm-applet --indicator &
blueman-applet &
nextcloud --background &
