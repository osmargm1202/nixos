#!/usr/bin/env bash
# Shared Rofi helpers for Sway menus. Source this file; do not execute it.

hypr_rofi_load_env() {
  HYPR_ROFI_THEME="${HYPR_ROFI_THEME:-$HOME/.config/rofi-sway/sway-launcher.rasi}"
  HYPR_ROFI_ENV="${HYPR_ROFI_ENV:-$HOME/.config/rofi/hypr-menu.env}"

  if [ -f "$HYPR_ROFI_ENV" ]; then
    # shellcheck disable=SC1090
    . "$HYPR_ROFI_ENV"
  fi

  HYPR_ROFI_SCALE="${HYPR_ROFI_SCALE:-1.00}"
  HYPR_ROFI_WIDTH="${HYPR_ROFI_WIDTH:-$(awk -v s="$HYPR_ROFI_SCALE" 'BEGIN { printf "%dpx", 640 * s }')}"
  HYPR_ROFI_LINES="${HYPR_ROFI_LINES:-$(awk -v s="$HYPR_ROFI_SCALE" 'BEGIN { printf "%d", 13 * s }')}"
  HYPR_ROFI_FONT_SIZE="${HYPR_ROFI_FONT_SIZE:-$(awk -v s="$HYPR_ROFI_SCALE" 'BEGIN { printf "%d", 12 * s }')}"
  HYPR_ROFI_ICON_SIZE="${HYPR_ROFI_ICON_SIZE:-$(awk -v s="$HYPR_ROFI_SCALE" 'BEGIN { printf "%dpx", 32 * s }')}"
  HYPR_ROFI_ELEMENT_PADDING="${HYPR_ROFI_ELEMENT_PADDING:-$(awk -v s="$HYPR_ROFI_SCALE" 'BEGIN { printf "%dpx", 8 * s }')}"
}

hypr_rofi_need() {
  if ! command -v rofi >/dev/null 2>&1; then
    notify-send "Rofi" "rofi no está instalado." 2>/dev/null || true
    return 1
  fi
}

hypr_rofi_theme_str() {
  local lines="${1:-$HYPR_ROFI_LINES}"
  local width="${2:-$HYPR_ROFI_WIDTH}"
  cat <<EOF
configuration {
  font: "JetBrainsMono Nerd Font ${HYPR_ROFI_FONT_SIZE}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
}
window { width: ${width}; }
listview { lines: ${lines}; }
element { padding: ${HYPR_ROFI_ELEMENT_PADDING}; cursor: pointer; }
element-icon { size: ${HYPR_ROFI_ICON_SIZE}; }
EOF
}

hypr_rofi_common() {
  "${ORGM_ROFI:-$HOME/.local/bin/orgm-rofi}" --compositor hyprland \
    --lines "$1" --width "$2" --font-size "${HYPR_ROFI_FONT_SIZE}" \
    --padding "${HYPR_ROFI_ELEMENT_PADDING}" --icon-size "${HYPR_ROFI_ICON_SIZE}" "${@:3}"
}

hypr_rofi_dmenu() {
  hypr_rofi_need || return 1
  hypr_rofi_common "${2:-$HYPR_ROFI_LINES}" "${3:-$HYPR_ROFI_WIDTH}" -dmenu -i -show-icons -p "$1"
}

hypr_rofi_markup_dmenu() {
  hypr_rofi_need || return 1
  hypr_rofi_common "${2:-$HYPR_ROFI_LINES}" "${3:-$HYPR_ROFI_WIDTH}" -dmenu -i -show-icons -markup-rows -p "$1"
}

hypr_rofi_drun() {
  hypr_rofi_need || return 1
  hypr_rofi_common "${HYPR_ROFI_LAUNCHER_LINES:-8}" "${HYPR_ROFI_LAUNCHER_WIDTH:-640px}" -show drun
}

hypr_rofi_load_env
