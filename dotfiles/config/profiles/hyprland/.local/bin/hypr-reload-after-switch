#!/usr/bin/env bash
set -u

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
helper="$HOME/.local/bin/hypr-session-refresh"

for instance_dir in "$runtime_dir"/hypr/*; do
  [ -S "$instance_dir/.socket.sock" ] || continue
  signature="${instance_dir##*/}"

  if ! XDG_RUNTIME_DIR="$runtime_dir" HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl -j monitors >/dev/null 2>&1; then
    continue
  fi

  XDG_RUNTIME_DIR="$runtime_dir" HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl reload >/dev/null 2>&1 || exit 1

  # Dispatch inside Hyprland's session environment so profile outputs, GTK,
  # game-mode wallpaper state, dock and Waybar refresh in deterministic order.
  if [ -x "$helper" ]; then
    XDG_RUNTIME_DIR="$runtime_dir" HYPRLAND_INSTANCE_SIGNATURE="$signature" \
      hyprctl dispatch exec "$helper" >/dev/null 2>&1 || exit 1
  fi
  exit 0
done

# Switching profiles without a live Hyprland session is valid.
exit 0
