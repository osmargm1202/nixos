#!/usr/bin/env python3
"""Choose normal dock or compact touch dock inside the same session-owned unit."""
import json,os,runpy,sys
from pathlib import Path
core=Path(__file__).resolve().parent.parent/'lib/orgm-wayland'
comp=sys.argv[1] if len(sys.argv)>1 else ''
if comp not in ('sway','hyprland'):raise SystemExit('Compositor de dock no válido')
policy=runpy.run_path(str(core/'tablet.py'))
if policy['load_policy']()['mode']=='on':
    os.environ['ORGM_DESKTOP_COMPOSITOR']=comp
    palette=runpy.run_path(str(core/'shell.py'),init_globals={'COMPOSITOR':comp})['menu_colors']()
    os.environ['ORGM_TABLET_PALETTE']=json.dumps(palette)
    ui=Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))/'quickshell/orgm-tablet-dock/shell.qml'
    os.execvp('qs',['qs','--no-duplicate','--path',str(ui)])
if len(sys.argv)>2:
    os.execvp(sys.argv[2],sys.argv[2:])
elif comp=='hyprland':
    os.environ['ORGM_DOCK_NORMAL']='1'
    os.execvp('hypr-nwg-dock',['hypr-nwg-dock'])
else:raise SystemExit('Falta el comando normal del dock Sway')
