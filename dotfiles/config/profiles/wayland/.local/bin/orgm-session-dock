#!/usr/bin/env python3
"""Preserve the native app dock and favorites; enlarge manual-tablet icons."""
import os,runpy,sys
from pathlib import Path
core=Path(__file__).resolve().parent.parent/'lib/orgm-wayland'
comp=sys.argv[1] if len(sys.argv)>1 else ''
if comp not in ('sway','hyprland'):raise SystemExit('Compositor de dock no válido')
policy=runpy.run_path(str(core/'tablet.py'))
if len(sys.argv)>2:
    args=policy['dock_command'](sys.argv[2:],policy['load_policy']()['mode']=='on')
    os.execvp(args[0],args)
elif comp=='hyprland':
    # Compatibility with older wrappers; never redirect to a replacement UI.
    os.environ['ORGM_DOCK_NORMAL']='1'
    os.execvp('hypr-nwg-dock',['hypr-nwg-dock'])
else:raise SystemExit('Falta el comando normal del dock Sway')
