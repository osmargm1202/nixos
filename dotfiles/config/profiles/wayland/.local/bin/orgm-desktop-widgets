#!/usr/bin/env python3
"""Standalone Ryoku-derived widgets; never reads or changes Ryoku state."""
import json
import math
import os
from pathlib import Path
import sys

DEFAULTS = dict(clockDesign='digital', clock24h=True, clockSeconds=False,
                dateShow=True, clockEnabled=True, clockScale=1.0, clockX=72, clockY=64,
                calendarEnabled=True, calendarScale=1.0, calendarX=64, calendarY=704,
                calendarWeekNumbers=True, calendarWeeks=6)


def load_settings(path):
    try:
        data = json.loads(Path(path).read_text())
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        data = {}
    settings = dict(DEFAULTS)
    for key, default in DEFAULTS.items():
        value = data.get(key, default)
        if isinstance(default, bool):
            if isinstance(value, bool):
                settings[key] = value
        elif isinstance(default, (float, int)):
            if isinstance(value, (float, int)) and not isinstance(value, bool) and math.isfinite(value):
                settings[key] = value
    for key in ('clockScale', 'calendarScale'):
        settings[key] = max(.4, min(3.0, settings[key]))
    for key in ('clockX', 'clockY', 'calendarX', 'calendarY'):
        settings[key] = max(0, min(16384, settings[key]))
    settings['calendarWeeks'] = max(4, min(8, round(settings['calendarWeeks'])))
    return settings


def main():
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))
    path = config/'orgm-desktop/widgets.json'
    settings = json.dumps(load_settings(path))
    action = sys.argv[1] if len(sys.argv) > 1 else 'daemon'
    if action == 'settings':
        print(settings)
        return
    if action != 'daemon':
        raise SystemExit('Uso: orgm-desktop-widgets [daemon|settings]')
    os.environ['ORGM_WIDGET_SETTINGS'] = settings
    os.environ['ORGM_WIDGET_CONFIG'] = str(path)
    os.environ['ORGM_WIDGET_BACKEND'] = str(Path(__file__).resolve())
    os.execvp('qs', ['qs', '--no-duplicate', '--path', str(config/'quickshell/orgm-desktop')])


if __name__ == '__main__':
    main()
