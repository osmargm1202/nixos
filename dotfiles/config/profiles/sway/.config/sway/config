# Editable copies managed per application by orgm-dot.
# Native SwayFX: modest blur/transparency; no Hyprland animation directives.
set $mod Mod4
set $term kitty
# Also works on reload in sessions started before the SDDM PATH fix.
set $exec exec env PATH="$HOME/.local/bin:$PATH"
font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod normal
focus_follows_mouse yes
# Keyboard focus changes carry the pointer into the selected window.
mouse_warping container
workspace_auto_back_and_forth yes
default_border none
default_floating_border none
gaps inner 5
gaps outer 5
# Reserve dock space independently of its process; leave Waybar full-width.
set $dock_gap 60
gaps right $dock_gap
client.focused #8bd5ca #24273a #cad3f5 #8bd5ca #8bd5ca
client.unfocused #363a4f #24273a #a5adcb #363a4f #363a4f
corner_radius 8
blur enable
blur_passes 2
blur_radius 5
shadows enable
shadow_blur_radius 20
shadow_color #00000066
shadow_offset 0 4
default_dim_inactive 0.05
# Keep browsers/video opaque; only terminal windows get compositor opacity.
for_window [app_id="^(kitty|orgmai-(chat|config))$"] opacity 0.94
layer_effects "waybar" {
    blur enable
    blur_xray enable
}
layer_effects "rofi" {
    blur enable
    shadows enable
    corner_radius 15
}
# No blurred/shadowed rectangle behind the backgroundless dock.
layer_effects "nwg-dock" {
    blur disable
    shadows disable
}
input type:keyboard {
    xkb_layout us,latam
    xkb_variant altgr-intl,
    xkb_numlock enabled
}
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}
output * bg #181926 solid_color
# Envy-specific outputs live in a separate copied file.
include ~/.config/sway/outputs.conf
include ~/.config/sway/workspaces.conf
include /etc/sway/config.d/*
exec_always env PATH="$HOME/.local/bin:$PATH" orgm-sway appearance
exec_always env PATH="$HOME/.local/bin:$PATH" orgm-sway wallpaper
include ~/.config/sway/window-rules.conf
bindsym $mod+Return $exec kitty
bindsym $mod+Shift+Return $exec kitty
bindsym $mod+Ctrl+Return $exec kitty -e tmux -u new-session -A -s main
bindsym $mod+e $exec nautilus --new-window
bindsym $mod+b $exec chromium
bindsym $mod+o $exec orgm-sway obsidian
bindsym $mod+w $exec sway-firefox-open-tab --restore-or-focus
bindsym $mod+Shift+w $exec sway-firefox-open-tab --focus
bindsym $mod+Ctrl+w $exec windows-rdp toggle
bindsym $mod+m $exec sway-firefox-open-tab --new-tab --prompt
bindsym $mod+Escape $exec sway-firefox-tabs
bindsym $mod+a $exec kitty --class orgmai-chat -o remember_window_size=no -e orgmai new
bindsym $mod+Shift+a $exec kitty --class orgmai-config -e orgmai prev
bindsym $mod+Ctrl+Shift+a $exec kitty --class orgmai-config -e orgmai config
bindsym $mod+Shift+p $exec kitty --class orgmai-chat -e pi -ne --no-mcp --no-skills --no-themes --use-theme dark
bindsym $mod+space $exec sway-app-launcher
bindsym $mod+Mod1+space $exec orgm-sway menu
bindsym $mod+slash $exec orgm-sway help
bindsym $mod+c $exec sway-rofi-calc
bindsym $mod+d $exec sway-rofi-ssh-host
bindsym $mod+Ctrl+period $exec sway-symbols
bindsym $mod+Ctrl+m $exec sway-rofi-open-file-dir
bindsym $mod+Shift+m $exec sway-rofi-open-file-terminal
bindsym $mod+v $exec sway-rofi-clipboard
bindsym $mod+n $exec swaync-client --toggle-panel --skip-wait
bindsym $mod+Shift+n $exec swaync-client --toggle-dnd --skip-wait
bindsym $mod+F10 $exec pavucontrol
bindsym $mod+z $exec woomer
bindsym $mod+Mod1+l $exec orgm-qylock lock
bindsym $mod+Ctrl+p $exec orgm-sway power
bindsym $mod+Mod1+e $exec orgm-sway power
bindsym $mod+Mod1+w $exec env ORGM_VISUAL_PROFILE_BACKEND=sway orgm-visual-profile random-wallpaper
bindsym Ctrl+space input type:keyboard xkb_switch_layout next
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad
bindsym $mod+Ctrl+s floating disable
bindsym $mod+Shift+Tab $exec sway-video-timer --backend sway
bindsym $mod+Tab focus prev
bindsym Mod1+Tab $exec orgm-sway windows
bindsym Mod1+Shift+Tab $exec orgm-sway windows prev
bindsym $mod+q kill
bindsym $mod+Shift+q $exec orgm-sway kill-window
bindsym $mod+Shift+e $exec orgm-sway logout
bindsym Ctrl+Mod1+Delete $exec orgm-sway logout
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle global
# A held Space must not toggle back through keyboard repeat.
bindsym --no-repeat $mod+Shift+space floating toggle
bindsym $mod+g layout toggle tabbed split
bindsym $mod+t split toggle
bindsym $mod+r split toggle
bindsym $mod+Ctrl+r split toggle
bindsym $mod+Ctrl+c move position center
bindsym $mod+grave focus next
bindsym $mod+Shift+grave focus prev
bindsym $mod+Ctrl+minus resize shrink width 20 px
bindsym $mod+Ctrl+equal resize grow width 20 px
bindsym $mod+Shift+minus resize shrink height 20 px
bindsym $mod+Shift+equal resize grow height 20 px
bindsym --locked XF86AudioRaiseVolume $exec sway-volume-osd up
bindsym --locked XF86AudioLowerVolume $exec sway-volume-osd down
bindsym --locked XF86AudioMute $exec sway-volume-osd mute
bindsym Ctrl+XF86AudioRaiseVolume $exec sway-mic-volume-osd up
bindsym Ctrl+XF86AudioLowerVolume $exec sway-mic-volume-osd down
bindsym --locked XF86AudioMicMute $exec sway-mic-volume-osd mute
bindsym --locked XF86AudioPlay $exec playerctl play-pause
bindsym --locked XF86AudioStop $exec playerctl stop
bindsym --locked XF86AudioPrev $exec playerctl previous
bindsym --locked XF86AudioNext $exec playerctl next
bindsym --locked XF86MonBrightnessUp $exec sway-brightness-osd up
bindsym --locked XF86MonBrightnessDown $exec sway-brightness-osd down
bindsym Print $exec orgm-sway screenshot region
bindsym Mod1+Print $exec orgm-sway screenshot region
bindsym Ctrl+Print $exec orgm-sway screenshot full
bindsym $mod+Print $exec record_screen_mp4
bindsym $mod+Shift+Print $exec record_screen_gif
bindsym $mod+Home workspace number 1
bindsym $mod+End workspace number 10
bindsym $mod+Ctrl+Home move container to workspace number 1
bindsym $mod+Ctrl+End move container to workspace number 10
bindsym $mod+Left focus left
bindsym $mod+Ctrl+Left move left
bindsym $mod+Shift+Left move left
bindsym $mod+Down focus down
bindsym $mod+Ctrl+Down move down
bindsym $mod+Shift+Down move down
bindsym $mod+Up focus up
bindsym $mod+Ctrl+Up move up
bindsym $mod+Shift+Up move up
bindsym $mod+Right focus right
bindsym $mod+Ctrl+Right move right
bindsym $mod+Shift+Right move right
bindsym $mod+h focus left
bindsym $mod+Ctrl+h move left
bindsym $mod+j focus down
bindsym $mod+Ctrl+j move down
bindsym $mod+k focus up
bindsym $mod+Ctrl+k move up
bindsym $mod+l $exec orgm-qylock lock
bindsym $mod+Ctrl+l move right
bindsym $mod+Mod1+Left resize shrink width 40 px
bindsym $mod+Mod1+Right resize grow width 40 px
bindsym $mod+Mod1+Up resize shrink height 40 px
bindsym $mod+Mod1+Down resize grow height 40 px
bindsym $mod+Page_Down workspace prev
bindsym $mod+Ctrl+Page_Down $exec orgm-sway move-workspace prev
bindsym $mod+Page_Up workspace next
bindsym $mod+Ctrl+Page_Up $exec orgm-sway move-workspace next
bindsym $mod+u workspace prev
bindsym $mod+Ctrl+u $exec orgm-sway move-workspace prev
bindsym $mod+i workspace next
bindsym $mod+Ctrl+i $exec orgm-sway move-workspace next
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+button8 workspace prev
bindsym $mod+button9 workspace next

# Keep the gaming override last, including for windows opened after the toggle.
include ~/.config/sway/game-mode.conf
# Apply configured or gaming gaps to existing workspaces after each reload.
exec_always env PATH="$HOME/.local/bin:$PATH" sway-game-mode sync
