#!/usr/bin/env bash
set -euo pipefail

lib="${SWAY_MENU_LIB:-$HOME/.local/bin/sway-menu-lib}"
# shellcheck disable=SC1090
. "$lib"

theme="$(rofi_menu_theme)"
exec rofimoji \
  --selector rofi \
  --selector-args="-no-config -theme $theme" \
  --action clipboard \
  --files 'emojis_*' nerd_font math miscellaneous_symbols miscellaneous_symbols_and_arrows \
  --prompt 'Símbolo'
