#!/usr/bin/env python3
"""Toggle SwayFX's inexpensive desktop, retaining configured visual preferences."""
import fcntl
import glob
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import subprocess
import sys
import tempfile

SWAY = runpy.run_path(str(Path(__file__).with_name('orgm-sway')))
ipc = SWAY['ipc']
query = SWAY['query']


def paths():
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config')) / 'sway'
    state = Path(os.environ.get('XDG_STATE_HOME', Path.home()/'.local/state')) / 'orgm-sway'
    return config, state


def read_state():
    try:
        value = json.loads((paths()[1]/'game-mode.json').read_text())
        return dict(enabled=value.get('enabled') is True, dock=value.get('dock') is True)
    except (OSError, ValueError, AttributeError):
        return dict(enabled=False, dock=False)


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as output:
        output.write(value)
        temporary = Path(output.name)
    temporary.replace(path)


def unit(action):
    return subprocess.run(['systemctl', '--user', action, 'orgm-sway-dock.service'],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def configured_commands():
    """Replay only opacity/dimming/gaps, including the user's included files.

    Reload restores global and layer effects, but existing windows/workspaces
    retain their explicit IPC overrides. Do not replay execs or other actions.
    """
    variables = {}
    seen = set()
    commands = ['[all] opacity 1']
    layers = {'waybar', 'rofi', 'nwg-dock', 'swaync-control-center', 'swaync-notification-window'}

    def visit(filename):
        filename = filename.resolve()
        if filename in seen or filename == (paths()[0]/'game-mode.conf').resolve() or not filename.is_file():
            return
        seen.add(filename)
        for original in filename.read_text().splitlines():
            line = original.strip()
            if line.startswith('set $'):
                name, _, value = line[5:].partition(' ')
                variables[name] = value
                continue
            line = re.sub(r'\$([A-Za-z_][A-Za-z0-9_]*)',
                          lambda m: variables.get(m[1], os.environ.get(m[1], m[0])), line)
            if line.startswith('include '):
                for pattern in shlex.split(line[8:]):
                    pattern = Path(os.path.expanduser(pattern))
                    if not pattern.is_absolute():
                        pattern = filename.parent/pattern
                    for child in sorted(glob.glob(str(pattern))):
                        visit(Path(child))
            elif match := re.fullmatch(r'gaps (inner|outer|horizontal|vertical|top|right|bottom|left) (-?\d+)', line):
                commands.append(f'gaps {match[1]} all set {match[2]}')
            elif match := re.fullmatch(r'default_dim_inactive (0(?:\.\d+)?|1(?:\.0+)?)', line):
                commands.append('[all] dim_inactive ' + match[1])
            elif match := re.fullmatch(r'for_window (\[.*\]) (.*)', line):
                for action in re.split(r'[,;]', match[2]):
                    if effect := re.fullmatch(r'\s*(opacity|dim_inactive) (0(?:\.\d+)?|1(?:\.0+)?)\s*', action):
                        commands.append(f'{match[1]} {effect[1]} {effect[2]}')
            elif line.startswith('layer_effects '):
                parts = shlex.split(line)
                if len(parts) > 1:
                    layers.add(parts[1])

    visit(Path(query('get_version')['loaded_config_file_name']))
    for output in query('get_outputs'):
        layers.update(surface['namespace'] for surface in output.get('layer_shell_surfaces', [])
                      if isinstance(surface.get('namespace'), str))
    return commands, sorted(layers)


def overlay(layers):
    result = '''# Generated by sway-game-mode; disable it with the Waybar gamepad button.
blur disable
shadows disable
corner_radius 0
default_dim_inactive 0
gaps inner 0
gaps outer 0
gaps top 0
gaps right 0
gaps bottom 0
gaps left 0
for_window [all] opacity 1
for_window [all] dim_inactive 0
'''
    for name in layers:
        result += 'layer_effects ' + json.dumps(name) + ' {\n    blur disable\n    shadows disable\n    corner_radius 0\n}\n'
    return result


def apply_gaming(layers):
    for command in ['blur disable', 'shadows disable', 'corner_radius 0',
                    'default_dim_inactive 0', '[all] opacity 1', '[all] dim_inactive 0',
                    'gaps inner all set 0', 'gaps outer all set 0',
                    'gaps top all set 0', 'gaps right all set 0',
                    'gaps bottom all set 0', 'gaps left all set 0']:
        visual_command(command)
    for name in layers:
        for effect in ['blur disable', 'shadows disable', 'corner_radius 0']:
            ipc('layer_effects ' + json.dumps(name) + ' ' + json.dumps(effect))
    if unit('is-active').returncode == 0:
        result = unit('stop')
        if result.returncode:
            raise RuntimeError('No se pudo ocultar el dock')
    SWAY['hide_wallpaper']()


def visual_command(command):
    try:
        ipc(command)
    except subprocess.CalledProcessError as error:
        # for_window rules commonly have no currently open matching window.
        # Sway reports that benign case as an IPC failure with exit code 2.
        try:
            replies = json.loads(error.stdout or 'null')
        except ValueError:
            raise error
        if not (command.startswith('[') and isinstance(replies, list) and replies and
                all(reply.get('success') or
                    (reply.get('error') == 'No matching node.' and not reply.get('parse_error'))
                    for reply in replies)):
            raise


def restore(commands, state):
    for command in commands:
        visual_command(command)
    if state['dock'] and unit('start').returncode:
        raise RuntimeError('No se pudo restaurar el dock')
    SWAY['wallpaper']()


def main(action='toggle'):
    state = read_state()
    if action in ('status', 'waybar'):
        status = 'activated' if state['enabled'] else 'deactivated'
        if action == 'status':
            print(status)
        else:
            text = ('Modo gaming: activo · ventanas opacas, sin efectos, fondo negro y dock oculto'
                    if state['enabled'] else 'Modo gaming: desactivado · clic para reducir efectos y fondo')
            print(json.dumps(dict(text='󰊴', **{'class': status}, tooltip=text), ensure_ascii=False))
        return
    if action not in ('toggle', 'on', 'off', 'sync'):
        raise ValueError('Uso: sway-game-mode {toggle|on|off|status|waybar|sync}')
    config, directory = paths()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (directory/'game-mode.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_state()
        commands, layers = configured_commands()
        enabled = state['enabled'] if action == 'sync' else not state['enabled'] if action == 'toggle' else action == 'on'
        if action == 'sync':
            if state['enabled']:
                write(config/'game-mode.conf', overlay(layers))
                apply_gaming(layers)
            else:
                # One reload hook owns existing-workspace gaps in both modes.
                # An independent dock-gap exec can race the gaming overrides.
                for command in commands:
                    if command.startswith('gaps '):
                        ipc(command)
            return
        if enabled == state['enabled']:
            return
        previous = state.copy()
        generated = config/'game-mode.conf'
        previous_overlay = generated.read_text() if generated.is_file() else '# Gaming desactivado\n'
        if enabled:
            state['dock'] = unit('is-active').returncode == 0
        state['enabled'] = enabled
        try:
            write(directory/'game-mode.json', json.dumps(state)+'\n')
            write(generated, overlay(layers) if enabled else '# Gaming desactivado\n')
            ipc('reload')
            if enabled:
                apply_gaming(layers)
            else:
                restore(commands, state)
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
            write(directory/'game-mode.json', json.dumps(previous)+'\n')
            write(generated, previous_overlay)
            ipc('reload')
            if previous['enabled']:
                apply_gaming(layers)
            else:
                restore(commands, state)
            raise


if __name__ == '__main__':
    try:
        main(sys.argv[1] if len(sys.argv) > 1 else 'toggle')
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('sway-game-mode:', error, file=sys.stderr)
        sys.exit(1)
