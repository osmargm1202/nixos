#!/usr/bin/env python3
"""Pinned qylock catalog, SDDM selection, and fail-closed Wayland session lock.

No passwords enter this process: only Quickshell's PAM conversation sees them.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time


def config_home():
    return Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))


def package_metadata():
    executable = Path(__file__).resolve()
    roots = [executable.parent.parent] if executable.is_relative_to('/nix/store') and executable.parent.name == 'bin' else []
    roots += [Path('/run/current-system/sw'),
              Path(os.environ.get('XDG_STATE_HOME', Path.home()/'.local/state'))/'orgm-qylock-package']
    for root in roots:
        metadata = root/'share/orgm-qylock/runtime.json'
        if metadata.is_file():
            resolved = metadata.resolve(strict=True)
            if not resolved.is_relative_to('/nix/store'):
                raise ValueError('El runtime qylock debe proceder del paquete Nix inmutable')
            result = json.loads(resolved.read_text())
            if result.get('schema') == 1:
                return result
    raise RuntimeError('Falta el paquete orgm-qylock; reconstruye NixOS o instala su GC root')


def catalog(metadata):
    return json.loads(Path(metadata['catalog']).read_text())


def current_theme(metadata, items=None):
    choices = {item['id'] for item in (items if items is not None else catalog(metadata))}
    # The root-owned atomic theme symlink is shared with SDDM. Local/legacy
    # preferences are migration fallbacks only, before the first shared choice.
    if metadata.get('themeLink'):
        link = Path(metadata['themeLink'])
        try:
            info = link.lstat()
            if stat.S_ISLNK(info.st_mode) and info.st_uid == 0:
                selected = link.resolve(strict=True).relative_to(Path(metadata['themes']).resolve()).as_posix()
                if selected in choices:
                    return selected
        except (OSError, ValueError):
            pass
    for path in (config_home()/'orgm-qylock/theme', config_home()/'qylock/theme'):
        if path.is_file():
            selected = path.read_text().strip()
            if selected in choices:
                return selected
    return metadata['defaultTheme']


def atomic_text(path, text):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.'+path.name+'-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)


def select_theme(metadata, slug):
    if slug not in {item['id'] for item in catalog(metadata)}:
        raise ValueError('Tema desconocido: elige uno del catálogo instalado')
    helper = Path(metadata['apply']).resolve(strict=True)
    info = helper.stat()
    if not helper.is_relative_to('/nix/store') or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError('El helper SDDM no es un ejecutable Nix inmutable')
    # No selection is recorded before the privileged operation succeeds.
    result = subprocess.run(['/run/wrappers/bin/pkexec', str(helper), 'select', slug])
    if result.returncode:
        raise RuntimeError('No se cambió el tema: autorización cancelada o fallo al actualizar SDDM')
    # The privileged helper atomically commits the shared symlink. Do not
    # introduce a second, per-user selection which could diverge from SDDM.


def compositor_session():
    # Explicit desktop identity wins over inherited parent-compositor variables.
    desktops = os.environ.get('XDG_CURRENT_DESKTOP', '').lower().split(':')
    sway = os.environ.get('SWAYSOCK', '')
    hyprland = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
    if 'hyprland' in desktops:
        return 'hyprland', hyprland
    if 'sway' in desktops or sway:
        return 'sway', sway
    return 'hyprland', hyprland


def picker_catalog(metadata):
    items = catalog(metadata)
    colors = dict(bg='#080808', surface='#202020', fg='#f5f5f5', muted='#b8b8b8', accent='#8ab4f8', error='#ff8a8a')
    hyprland = compositor_session()[0] == 'hyprland'
    palette = config_home()/('waybar-hypr' if hyprland else 'waybar')/'orgm-current.css'
    if palette.is_file():
        values = dict(re.findall(r'^@define-color\s+(\w+)\s+(#[0-9a-fA-F]{6});\s*$', palette.read_text(), re.MULTILINE))
        for name, key in dict(bg='base', surface='surface0', fg='text', muted='overlay0', accent='blue', error='red').items():
            colors[name] = values.get(key, colors[name])
    screen = ''
    try:
        command = ['hyprctl', '-j', 'monitors'] if hyprland else ['swaymsg', '-r', '-t', 'get_workspaces']
        result = subprocess.run(command, capture_output=True, text=True, check=True, timeout=3)
        screen = next((w.get('name' if hyprland else 'output', '') for w in json.loads(result.stdout) if w.get('focused')), '')
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return dict(current=current_theme(metadata, items), colors=colors, screen=screen,
                backend=str(Path(__file__).resolve()), profile='qylock',
                items=[dict(id=i['id'], path=i['id'], name=i['name'],
                            url=(Path(metadata['previews'])/i['preview']).as_uri()) for i in items])


def choose_theme(metadata):
    local = config_home()/'quickshell/orgm-locks'
    qml = local if (local/'shell.qml').is_file() else Path(metadata['pickerQml'])
    with tempfile.TemporaryDirectory(prefix='orgm-lock-picker-') as directory:
        data, status = Path(directory)/'catalog.json', Path(directory)/'status'
        data.write_text(json.dumps(picker_catalog(metadata), ensure_ascii=False))
        data.chmod(0o600)
        with subprocess.Popen([metadata['qs'], '--no-duplicate', '--path', str(qml)],
                env=dict(os.environ, ORGM_WALLPAPER_DATA=str(data), ORGM_WALLPAPER_STATUS=str(status))) as child:
            deadline = time.monotonic()+10
            while child.poll() is None and not status.exists() and time.monotonic() < deadline:
                time.sleep(.05)
            if status.is_file() and status.read_text().strip() == 'ready':
                return child.wait()
            if child.poll() is not None:
                return child.returncode
            child.terminate()
            try:
                child.wait(timeout=2)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
            raise RuntimeError('No se pudo abrir el carrusel de temas')


def fingerprint_available(metadata, user):
    # No probe: a Nix opt-in authorizes only the lock's parallel PAM service.
    # A per-user off switch wins. Preparing a driver alone never enables it.
    if not metadata.get('fingerprintEnabled', False):
        return False
    preference = config_home()/'orgm-qylock/fingerprint'
    return not (preference.is_file() and preference.read_text().strip().lower() in ('0', 'false', 'off', 'disabled'))


def lock_settings(metadata):
    selected = current_theme(metadata)
    item = next(i for i in catalog(metadata) if i['id'] == selected)
    user = pwd.getpwuid(os.getuid())
    return dict(id=selected, config=item['config'],
                themeUrl=(Path(metadata['themes'])/selected).as_uri(),
                pamDirectory=metadata['pamDirectory'], user=user.pw_name,
                realName=user.pw_gecos.split(',')[0] or user.pw_name,
                home=user.pw_dir, host=socket.gethostname(), icon='',
                fingerprint=fingerprint_available(metadata, user.pw_name))


def runtime_paths():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise ValueError('XDG_RUNTIME_DIR debe ser un directorio privado del usuario')
    compositor, identity = compositor_session()
    # Preserve Sway's key: its preview recorder checks the same lock file.
    if compositor == 'hyprland':
        identity = 'hyprland:'+identity
    key = hashlib.sha256((os.environ.get('WAYLAND_DISPLAY', '')+'\0'+identity).encode()).hexdigest()[:20]
    return runtime, runtime/('orgm-qylock-'+key+'.lock'), runtime/('orgm-qylock-'+key+'.json')


def compositor_secure(metadata, information):
    try:
        info = json.loads(information.read_text())
        result = subprocess.run([metadata['qs'], 'ipc', '--pid', str(int(info['pid'])),
                                 'call', 'orgm-lock', 'status'], capture_output=True, text=True, timeout=1)
        state = json.loads(result.stdout) if result.returncode == 0 else {}
        return state.get('secure') is True and not state.get('authenticated')
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return False


def lock(metadata):
    if not os.environ.get('WAYLAND_DISPLAY') or not compositor_session()[1]:
        raise RuntimeError('Este bloqueo requiere una sesión Sway o Hyprland/Wayland activa')
    runtime, lockfile, information = runtime_paths()
    fd = os.open(lockfile, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    supervisor = None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('Archivo de exclusión de bloqueo no válido')
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            deadline = time.monotonic()+10
            while time.monotonic() < deadline:
                if compositor_secure(metadata, information):
                    return 0
                # An authenticated lock may still be animating its exit. Wait
                # for its supervisor to release ownership, then acquire a NEW
                # secure lock before acknowledging before-sleep.
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    time.sleep(.1)
            else:
                raise RuntimeError('Otro bloqueo está arrancando pero no confirmó la seguridad')
        instance = Path(tempfile.mkdtemp(prefix='orgm-qylock-instance-', dir=runtime))
        atomic_text(instance/'data.json', json.dumps(lock_settings(metadata), ensure_ascii=False))
        atomic_text(instance/'metadata.json', json.dumps(metadata))
        with (instance/'session.log').open('w') as log:
            log_fd = log.fileno()
            os.fchmod(log_fd, 0o600)
            supervisor = subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                '_supervise', str(instance), str(fd)], pass_fds=(fd,), start_new_session=True,
                stdin=subprocess.DEVNULL, stdout=log, stderr=log)
        deadline = time.monotonic()+10
        while time.monotonic() < deadline and supervisor.poll() is None:
            ready = instance/'ready'
            if ready.is_file():
                if ready.read_text().strip() == 'secure' and compositor_secure(metadata, information):
                    return 0
                if ready.read_text().strip() == 'error':
                    break
            time.sleep(.05)
        # Never kill a possibly secured client on a timeout: losing it can
        # abandon the compositor lock. Return failure, not a false ready signal.
        raise RuntimeError('El compositor no confirmó el bloqueo; no se ha solicitado suspender')
    finally:
        os.close(fd)


def supervise(instance, inherited_fd):
    runtime, lockfile, information = runtime_paths()
    instance = Path(instance)
    info = instance.lstat()
    if (instance.parent.resolve() != runtime.resolve() or not instance.name.startswith('orgm-qylock-instance-')
            or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700):
        raise ValueError('Directorio de supervisor no válido')
    held = os.fstat(inherited_fd)
    expected = lockfile.stat()
    if (held.st_dev, held.st_ino) != (expected.st_dev, expected.st_ino):
        raise ValueError('Descriptor de exclusión incorrecto')
    metadata = json.loads((instance/'metadata.json').read_text())
    result = None
    try:
        with subprocess.Popen([metadata['qs'], '--path', metadata['lockQml']],
                env=dict(os.environ, ORGM_LOCK_DATA=str(instance/'data.json'),
                         ORGM_LOCK_READY=str(instance/'ready'))) as child:
            atomic_text(information, json.dumps(dict(pid=child.pid, supervisor=os.getpid(), instance=str(instance))))
            result = child.wait()
            return result
    finally:
        # Keep failure logs for diagnosis. A successful unlock normally exits 0.
        try:
            current = json.loads(information.read_text())
            if current.get('instance') == str(instance):
                information.unlink()
        except (OSError, ValueError):
            pass
        os.close(inherited_fd)
        try:
            if result == 0 and (instance/'ready').read_text() == 'unlocked':
                shutil.rmtree(instance)
        except OSError:
            pass


def main(args):
    command = args[0] if args else 'lock'
    if command == '_supervise' and len(args) == 3:
        return supervise(args[1], int(args[2]))
    metadata = package_metadata()
    if command == 'dismiss-clock' and len(args) == 1:
        _, _, information = runtime_paths()
        if not information.is_file():
            return 0
        details = json.loads(information.read_text())
        subprocess.run([metadata['qs'], 'ipc', '--pid', str(int(details['pid'])),
                        'call', 'orgm-lock', 'dismissClock'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        return 0
    if command == 'lock' and len(args) <= 1:
        return lock(metadata)
    if command == 'themes' and len(args) == 1:
        return choose_theme(metadata)
    if command == 'select' and len(args) == 2:
        select_theme(metadata, args[1])
        return 0
    if command == 'catalog' and len(args) == 1:
        print(json.dumps(picker_catalog(metadata), ensure_ascii=False))
        return 0
    raise ValueError('Uso: orgm-qylock [lock|themes|select ID|catalog]')


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print('orgm-qylock:', error, file=sys.stderr)
        sys.exit(1)
