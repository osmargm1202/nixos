#!/usr/bin/env bash
set -euo pipefail

TOOL=$(gum choose --header "AI Tool:" pi claude codex opencode) || exit 0
[ -z "$TOOL" ] && exit 0

PROMPT=$(gum input --placeholder "Prompt para $TOOL...") || exit 0
[ -z "$PROMPT" ] && exit 0

# El FHS `dev` ya no existe; pi/claude/codex viven en PATH normal (nix-ld)
exec kitty --hold -e "$TOOL" "$PROMPT"
