#!/usr/bin/env bash
set -euo pipefail

notify() {
  notify-send "USB headset" "$1" 2>/dev/null || true
}

if [[ -n ${HYPR_HEADSET_RECONNECT_CMD+x} ]]; then
  reconnect_cmd=(bash -lc "$HYPR_HEADSET_RECONNECT_CMD")
else
  reconnect_cmd=(hypr-usb-menu reconnect-headset)
fi

if command -v kitty >/dev/null 2>&1; then
  kitty --title "USB headset reconnect" -e "${reconnect_cmd[@]}" &
  exit 0
fi

"${reconnect_cmd[@]}"
