# Portable NixOS adaptation of:
# https://github.com/krasiyan/dotfiles/blob/009b6ce04029ba4ee1878ad30a5cbfee95f0f630/.i3/i3blocks.conf
# Adapted from krasiyan/dotfiles@009b6ce04029ba4ee1878ad30a5cbfee95f0f630

command=$HOME/.local/bin/i3blocks-status "$BLOCK_NAME"
separator=false
separator_block_width=0
markup=pango
color=#D8DEE9FF
background=#3B4252B3
align=center

[caffeine]
label=
interval=5
min_width= OFF
background=#3B4252B3

[language]
label=
interval=2
min_width= LATAM
background=#434C5EB3

[brightness]
label=
interval=2
min_width= 100%
background=#3B4252B3

[volume]
label=
interval=1
min_width= 100%
background=#434C5EB3

[microphone]
label=
interval=2
min_width= 100%
background=#3B4252B3

[disk]
label=
instance=/
interval=30
min_width= 100G
background=#434C5EB3

[network]
interval=5
min_width= Network 100%
background=#3B4252B3

[memory]
label=
interval=2
min_width= 99.9G
background=#434C5EB3

[cpu]
label=
interval=2
min_width= 100%
background=#3B4252B3

[temperature]
label=
interval=5
min_width= 100°C
background=#434C5EB3

[battery]
interval=15
min_width= 100%
background=#3B4252B3

[time]
interval=1
min_width=miércoles 00/00/0000 00:00 PM
background=#434C5EB3
