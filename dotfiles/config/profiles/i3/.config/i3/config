set $mod Mod4
set $run $HOME/.local/bin/i3-run
set $term kitty
set $browser $run i3-zen-new-window
set $files sh -lc 'nautilus --new-window "$HOME" >/tmp/i3-nautilus.log 2>&1 || gtk-launch org.gnome.Nautilus.desktop >/tmp/i3-nautilus.log 2>&1 || xdg-open "$HOME" >/tmp/i3-nautilus.log 2>&1'
set $launcher $run i3-rofi --drun

font pango:JetBrainsMono Nerd Font 11
floating_modifier $mod
tiling_drag modifier titlebar

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id /run/current-system/sw/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id udiskie --tray
exec --no-startup-id dunst
exec --no-startup-id clipmenud
exec --no-startup-id $run i3-expo-daemon
exec --no-startup-id xss-lock --transfer-sleep-lock -- $run i3-lock --nofork
exec --no-startup-id $run i3-caffeine-toggle off
exec --no-startup-id $run i3-monitor-profile --apply
exec --no-startup-id setxkbmap -layout "us,latam" -variant "altgr-intl," -option "grp:ctrl_space_toggle"

bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+Return exec --no-startup-id $term
bindsym $mod+space exec --no-startup-id $run i3-rofi --drun
bindsym $mod+Escape exec --no-startup-id $run i3-expo-toggle
bindsym $mod+Tab workspace back_and_forth
bindsym Mod1+Tab exec --no-startup-id $run i3-rofi --window
bindsym $mod+c exec --no-startup-id $run i3-calc
bindsym $mod+Shift+c exec --no-startup-id $run i3-caffeine-toggle
bindsym $mod+v exec --no-startup-id $run i3-clipboard
bindsym $mod+m exec --no-startup-id $run i3-open-file open
bindsym $mod+Ctrl+m exec --no-startup-id $run i3-open-file dir
bindsym $mod+Shift+m exec --no-startup-id $run i3-open-file terminal
bindsym $mod+d exec --no-startup-id $run i3-ssh-host
bindsym $mod+slash exec --no-startup-id $run i3-hotkeys
bindcode $mod+Mod1+65 exec --no-startup-id $run i3-main-menu
bindsym $mod+F12 exec --no-startup-id $run i3-main-menu
bindsym $mod+Mod1+w exec --no-startup-id $run i3-wallpaper --random
bindsym $mod+p exec --no-startup-id $run i3-monitor-profile
bindsym $mod+Ctrl+comma exec --no-startup-id $run i3-monitor-profile
bindsym $mod+w exec --no-startup-id $run i3-zen-new-window
bindsym $mod+Shift+w exec --no-startup-id chromium
bindsym $mod+o exec --no-startup-id $run i3-obsidian-open-or-focus
bindsym $mod+Shift+p exec --no-startup-id $run i3-pi-prompt
bindsym $mod+e exec --no-startup-id $files
bindsym $mod+F10 exec --no-startup-id pavucontrol
bindsym $mod+Mod1+e exec --no-startup-id $run i3-powermenu
bindsym $mod+Mod1+l exec --no-startup-id $run i3-lock
bindsym $mod+Ctrl+r layout toggle split
bindsym $mod+q kill
bindsym $mod+Shift+q exec --no-startup-id xkill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+BackSpace reload
bindsym $mod+Shift+e exec --no-startup-id i3-msg exit
bindsym Ctrl+Mod1+Delete exec --no-startup-id i3-msg exit
bindsym $mod+n exec --no-startup-id dunstctl history-pop
bindsym $mod+Shift+n exec --no-startup-id dunstctl set-paused toggle
bindsym $mod+Ctrl+Shift+m exec --no-startup-id dunstctl close-all

bindsym Print exec --no-startup-id flameshot gui
bindsym Ctrl+Print exec --no-startup-id flameshot full -c
bindsym Mod1+Print exec --no-startup-id flameshot gui
bindsym $mod+Shift+l exec --no-startup-id $run i3-lock
bindsym $mod+Mod1+p exec --no-startup-id xset dpms force off
bindsym $mod+Shift+o exec --no-startup-id systemctl suspend
bindsym $mod+Mod1+o exec --no-startup-id systemctl poweroff
bindsym $mod+Mod1+r exec --no-startup-id systemctl reboot

bindsym XF86AudioRaiseVolume exec --no-startup-id $run volume-osd up
bindsym XF86AudioLowerVolume exec --no-startup-id $run volume-osd down
bindsym XF86AudioMute exec --no-startup-id $run volume-osd mute
bindsym Ctrl+XF86AudioRaiseVolume exec --no-startup-id $run mic-volume-osd up
bindsym Ctrl+XF86AudioLowerVolume exec --no-startup-id $run mic-volume-osd down
bindsym XF86AudioMicMute exec --no-startup-id $run mic-volume-osd mute
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioStop exec --no-startup-id playerctl stop
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86MonBrightnessUp exec --no-startup-id $run brightness-osd up
bindsym XF86MonBrightnessDown exec --no-startup-id $run brightness-osd down
bindsym XF86WLAN exec --no-startup-id $run i3-wifi-toggle
bindsym XF86RFKill exec --no-startup-id $run i3-wifi-toggle

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Down move down
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+c move position center
bindsym $mod+grave focus right
bindsym $mod+Shift+grave focus left
bindsym $mod+g layout tabbed
bindsym $mod+Shift+g layout default
bindsym $mod+t layout toggle split
bindsym $mod+r layout toggle split
bindsym $mod+Ctrl+minus resize shrink width 20 px
bindsym $mod+Ctrl+equal resize grow width 20 px
bindsym $mod+Shift+minus resize shrink height 20 px
bindsym $mod+Shift+equal resize grow height 20 px
bindsym $mod+Mod1+Left resize shrink width 40 px
bindsym $mod+Mod1+Right resize grow width 40 px
bindsym $mod+Mod1+Up resize shrink height 40 px
bindsym $mod+Mod1+Down resize grow height 40 px

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Home workspace number $ws1
bindsym $mod+End workspace number $ws10
bindsym $mod+Page_Down workspace prev
bindsym $mod+Page_Up workspace next
bindsym $mod+u workspace prev
bindsym $mod+i workspace next

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Ctrl+Home move container to workspace number $ws1
bindsym $mod+Ctrl+End move container to workspace number $ws10
bindsym $mod+Ctrl+Page_Down move container to workspace prev
bindsym $mod+Ctrl+Page_Up move container to workspace next
bindsym $mod+Ctrl+u move container to workspace prev
bindsym $mod+Ctrl+i move container to workspace next

mode "resize" {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt
  bindsym Left resize shrink width 10 px or 10 ppt
  bindsym Down resize grow height 10 px or 10 ppt
  bindsym Up resize shrink height 10 px or 10 ppt
  bindsym Right resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+Ctrl+Mod1+r mode "resize"

for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="flameshot"] floating enable
for_window [all] border pixel 1

gaps inner 8
gaps outer 4

client.focused          #7aa2f7 #1a1b26 #c0caf5 #7aa2f7 #1a1b26
client.focused_inactive #1f2335 #1a1b26 #a9b1d6 #292e42 #1a1b26
client.unfocused        #1f2335 #1a1b26 #565f89 #292e42 #1a1b26
client.urgent           #f7768e #1a1b26 #ffffff #f7768e #1a1b26

bar {
  font pango:Noto Sans, JetBrainsMono Nerd Font 18
  height 28
  status_command bumblebee-status -m shortcut date time -p shortcut.cmds="$HOME/.local/bin/i3-caffeine-toggle" shortcut.labels="" date.format="%A %d/%m/%Y" date.locale="es_DO.UTF-8" time.format="%I:%M %p" time.locale="en_US.UTF-8" -i i3-clean -t nord-powerline
  tray_output primary
}
