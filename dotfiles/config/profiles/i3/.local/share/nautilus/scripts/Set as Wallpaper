#!/usr/bin/env bash
set -euo pipefail

helper="${I3_WALLPAPER_HELPER:-$HOME/.local/bin/i3-wallpaper}"
if [[ -z "${I3_WALLPAPER_HELPER:-}" ]] && command -v i3-wallpaper >/dev/null 2>&1; then
  helper="$(command -v i3-wallpaper)"
fi
mapfile -t selected <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}"
files=()
for path in "${selected[@]}"; do
  [[ -n "$path" ]] && files+=("$path")
done

if ((${#files[@]} != 1)); then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send 'Set as Wallpaper' 'Selecciona exactamente una imagen local.' || true
  exit 1
fi

exec "$helper" --set "${files[0]}"
