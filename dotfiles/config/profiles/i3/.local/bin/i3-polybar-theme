#!/usr/bin/env bash
set -euo pipefail

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/polybar-themes"
selection_file="$state_root/current"

[[ "${1:-}" == select ]] || {
  printf 'usage: i3-polybar-theme select\n' >&2
  exit 2
}

choice="$(printf '%s\n' \
  'Zorin (Panels)' \
  'Budgie (Panels)' \
  'Deepin (Panels)' \
  'Elementary (Panels)' \
  'Elementary Dark (Panels)' \
  'GNOME (Panels)' \
  'KDE (Panels)' \
  'KDE Dark (Panels)' \
  'Liri (Panels)' \
  'Mint (Panels)' \
  'Ubuntu GNOME (Panels)' \
  'Ubuntu Unity (Panels)' \
  'Xubuntu (Panels)' \
  Blocks \
  Colorblocks \
  Cuts \
  Docky \
  Forest \
  Grayblocks \
  Hack \
  Material \
  Pwidgets \
  Shades \
  Shapes \
  | i3-rofi 'Polybar theme' 24 || true)"

case "$choice" in
  'Zorin (Panels)') theme=panels:zorin ;;
  'Budgie (Panels)') theme=panels:budgie ;;
  'Deepin (Panels)') theme=panels:deepin ;;
  'Elementary (Panels)') theme=panels:elementary ;;
  'Elementary Dark (Panels)') theme=panels:elementary_dark ;;
  'GNOME (Panels)') theme=panels:gnome ;;
  'KDE (Panels)') theme=panels:kde ;;
  'KDE Dark (Panels)') theme=panels:kde_dark ;;
  'Liri (Panels)') theme=panels:liri ;;
  'Mint (Panels)') theme=panels:mint ;;
  'Ubuntu GNOME (Panels)') theme=panels:ubuntu_gnome ;;
  'Ubuntu Unity (Panels)') theme=panels:ubuntu_unity ;;
  'Xubuntu (Panels)') theme=panels:xubuntu ;;
  Blocks) theme=blocks ;;
  Colorblocks) theme=colorblocks ;;
  Cuts) theme=cuts ;;
  Docky) theme=docky ;;
  Forest) theme=forest ;;
  Grayblocks) theme=grayblocks ;;
  Hack) theme=hack ;;
  Material) theme=material ;;
  Pwidgets) theme=pwidgets ;;
  Shades) theme=shades ;;
  Shapes) theme=shapes ;;
  *) exit 0 ;;
esac

install -d "$state_root"
temporary_file="$(mktemp "$selection_file.tmp.XXXXXX")"
printf '%s\n' "$theme" > "$temporary_file"
mv "$temporary_file" "$selection_file"
exec "$HOME/.local/bin/i3-polybar" start --no-sync
