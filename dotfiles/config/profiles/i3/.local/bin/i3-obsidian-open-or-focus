#!/usr/bin/env bash
set -euo pipefail

if command -v i3-msg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  con_id="$(i3-msg -t get_tree 2>/dev/null | jq -r '
    .. | objects
    | select(.window_properties? != null)
    | select(
        ((.window_properties.class // "") | test("obsidian"; "i"))
        or ((.name // "") | test("obsidian"; "i"))
      )
    | .id
  ' | head -n1)"
  if [[ -n "$con_id" ]]; then
    exec i3-msg "[con_id=$con_id] focus"
  fi
fi

if command -v obsidian >/dev/null 2>&1; then
  exec obsidian
fi
if command -v flatpak >/dev/null 2>&1 && flatpak info md.obsidian.Obsidian >/dev/null 2>&1; then
  exec flatpak run md.obsidian.Obsidian
fi
exec xdg-open obsidian://open
