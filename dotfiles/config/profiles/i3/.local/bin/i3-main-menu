#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' \
  Apps Windows Terminal Zen Chromium Files Obsidian Calculator Clipboard SSH Devices Wallpaper 'Polybar theme' Performance Help 'Edit config' Power \
  | i3-rofi 'i3' 17 || true)"

case "$choice" in
  Apps) exec i3-rofi --drun ;;
  Windows) exec i3-rofi --window ;;
  Terminal) exec kitty ;;
  Zen) exec i3-zen-new-window ;;
  Chromium) exec chromium ;;
  Files) exec i3-open-file open ;;
  Obsidian) exec i3-obsidian-open-or-focus ;;
  Calculator) exec i3-calc ;;
  Clipboard) exec i3-clipboard ;;
  SSH) exec i3-ssh-host ;;
  Devices) exec i3-devices-menu ;;
  Wallpaper) exec i3-wallpaper --random ;;
  'Polybar theme') exec i3-polybar-theme select ;;
  Performance) exec i3-performance-menu ;;
  Help) exec i3-hotkeys ;;
  'Edit config') exec i3-config-editor ;;
  Power) exec xlogout ;;
  *) exit 0 ;;
esac
