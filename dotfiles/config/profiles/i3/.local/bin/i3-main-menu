#!/usr/bin/env bash
set -euo pipefail

extension="${XDG_CONFIG_HOME:-$HOME/.config}/i3/main-menu.conf"
if [[ -r "$extension" ]]; then
  # User profile extensions define menu entries and only their own actions.
  # shellcheck disable=SC1090
  . "$extension"
fi

menu_items=(
  Apps Windows Terminal Browser Files Calculator Clipboard Symbols Devices
  Wallpaper Performance Help Power
)
if declare -F i3_main_menu_items >/dev/null; then
  mapfile -t menu_items < <(i3_main_menu_items)
fi

choice="$(printf '%s\n' "${menu_items[@]}" | i3-rofi 'i3' "${#menu_items[@]}" || true)"

# User actions also override shared entries, such as the personal wallpaper policy.
if declare -F i3_main_menu_exec >/dev/null && i3_main_menu_exec "$choice"; then
  exit 0
fi

case "$choice" in
  Apps) exec i3-rofi --drun ;;
  Windows) exec i3-rofi --window ;;
  Terminal) exec kitty ;;
  Browser) exec xdg-open 'https://www.google.com' ;;
  Files) exec i3-open-file open ;;
  Calculator) exec i3-calc ;;
  Clipboard) exec i3-clipboard ;;
  Symbols) exec rofi-symbols ;;
  Devices) exec i3-devices-menu ;;
  Wallpaper) exec i3-wallpaper --random ;;
  Performance) exec i3-performance-menu ;;
  Help) exec i3-hotkeys ;;
  Power) exec xlogout ;;
  *) exit 0 ;;
esac
