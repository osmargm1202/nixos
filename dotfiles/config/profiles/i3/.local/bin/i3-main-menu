#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' \
  Apps Windows Terminal Firefox Files Obsidian Calculator Clipboard SSH Devices Wallpaper Performance Help 'Edit config' Power \
  | i3-rofi 'i3' 16 || true)"

case "$choice" in
  Apps) exec i3-rofi --drun ;;
  Windows) exec i3-rofi --window ;;
  Terminal) exec kitty ;;
  Firefox) exec "$HOME/.local/bin/i3-firefox-new-window" ;;
  Files) exec i3-open-file open ;;
  Obsidian) exec i3-obsidian-open-or-focus ;;
  Calculator) exec i3-calc ;;
  Clipboard) exec i3-clipboard ;;
  SSH) exec i3-ssh-host ;;
  Devices) exec i3-devices-menu ;;
  Wallpaper) exec i3-wallpaper --random ;;
  Performance) exec i3-performance-menu ;;
  Help) exec i3-hotkeys ;;
  'Edit config') exec i3-config-editor ;;
  Power) exec xlogout ;;
  *) exit 0 ;;
esac
