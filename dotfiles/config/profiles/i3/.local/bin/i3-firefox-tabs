#!/usr/bin/env bash
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Firefox" "$1" 2>/dev/null || true
}

command -v windows-manager-linux-orgm-tabs >/dev/null 2>&1 || {
  notify "El puente de pestañas no está instalado"
  exit 1
}

command -v python3 >/dev/null 2>&1 || {
  notify "Python no está instalado"
  exit 1
}

tabs="$(windows-manager-linux-orgm-tabs list)" || {
  notify "No se pudo consultar las pestañas existentes"
  exit 1
}

state="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/firefox-tabs.XXXXXX")"
trap 'rm -rf "$state"' EXIT
printf '%s' "$tabs" >"$state/tabs.json"

if ! python3 - "$state/ids" "$state/tabs.json" <<'PY' | i3-rofi --tab-picker >"$state/selection"; then
import json
import os
import sys
from pathlib import Path
from urllib.parse import urlsplit

state_path = Path(sys.argv[1])
tabs = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
if not isinstance(tabs, list):
    raise ValueError("invalid tab list")


def clean(value):
    return "".join(char if ord(char) >= 0x20 and char not in "\x7f\x1f" else " " for char in value).strip()


for tab in tabs:
    if not isinstance(tab, dict) or not isinstance(tab.get("id"), int) or tab["id"] <= 0:
        raise ValueError("invalid tab descriptor")
    title = clean(tab.get("title") or "Pestaña sin título")
    try:
        host = urlsplit(tab.get("url") or "").hostname or "Firefox"
    except ValueError:
        host = "Firefox"
    icon = tab.get("iconPath")
    if not isinstance(icon, str) or not icon.startswith("/") or not os.path.isfile(icon):
        icon = "firefox"
    print(f"{title} — {clean(host)}\0icon\x1f{icon}")
    print(tab["id"], file=state_path.open("a", encoding="utf-8"))
PY
  notify "No hay pestañas Firefox disponibles"
  exit 0
fi

selection="$(<"$state/selection")"
[[ "$selection" =~ ^[0-9]+$ ]] || exit 0
mapfile -t ids <"$state/ids"
(( selection < ${#ids[@]} )) || {
  notify "La selección de pestaña no es válida"
  exit 1
}

windows-manager-linux-orgm-tabs activate "${ids[selection]}" || {
  notify "La pestaña seleccionada ya no existe"
  exit 1
}
