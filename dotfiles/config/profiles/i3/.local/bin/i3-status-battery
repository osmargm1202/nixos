#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

root="${I3_POWER_SUPPLY_ROOT:-/sys/class/power_supply}"
for device in "$root"/*; do
  [[ -f "$device/type" ]] || continue
  [[ "$(cat "$device/type")" == Battery ]] || continue
  [[ -f "$device/capacity" ]] || continue
  capacity="$(cat "$device/capacity")"
  [[ "$capacity" =~ ^[0-9]+$ ]] || continue
  status="$(cat "$device/status" 2>/dev/null || true)"
  case "$status" in
    Charging) icon='󰂄' ;;
    Full) icon='󰁹' ;;
    *) icon='󰁹' ;;
  esac
  printf '%s %s%%\n' "$icon" "$capacity"
  exit 0
done
exit 0
