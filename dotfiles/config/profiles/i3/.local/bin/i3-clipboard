#!/usr/bin/env bash
set -euo pipefail

export CM_LAUNCHER=rofi
export CM_HISTLENGTH=20
cache_base="${CM_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}}"
cache_file="$cache_base/clipmenu.6.$USER/line_cache"
theme="$HOME/.config/rofi/i3-menu.rasi"
theme_override='configuration { font: "JetBrainsMono Nerd Font 12"; }
window { width: 600px; }
listview { lines: 13; }
element { padding: 8px; cursor: pointer; }
element-icon { size: 32px; }'

if [[ ! -s "$cache_file" ]]; then
  notify-send 'Clipboard' 'No clipboard history yet — copia algo primero.' 2>/dev/null || true
  exit 0
fi

exec clipmenu -i -p Clipboard -theme "$theme" -theme-str "$theme_override"
