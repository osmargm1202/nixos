#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required for Clipcat}"
# The user manager may have started before LightDM supplied this X11 session.
# Import only the display variables, never the full shell environment.
if [[ -n "${DISPLAY:-}" ]]; then
  systemctl --user import-environment DISPLAY
fi
if [[ -n "${XAUTHORITY:-}" ]]; then
  systemctl --user import-environment XAUTHORITY
fi

if ! systemctl --user is-active --quiet i3-clipcat.service; then
  systemctl --user start i3-clipcat.service
fi

if [[ "${1:-}" == --start ]]; then
  exit 0
fi
config_template="$HOME/.config/clipcat/clipcat-menu.toml"
runtime_config="$runtime_dir/clipcat-menu.toml"
socket="$runtime_dir/clipcat/grpc.sock"
theme="$HOME/.config/rofi/i3-menu.rasi"
theme_override='configuration { font: "JetBrainsMono Nerd Font 11"; }
window { width: 500px; }
inputbar { margin: 0px 5px; }
prompt { padding: 6px; }
entry { padding: 6px; }
listview { fixed-height: false; scrollbar: true; }
element { padding: 4px; cursor: pointer; }
element-icon { size: 18px; }
@media (max-width: 550px) { window { width: 92%; } }'

for _ in {1..10}; do
  if count="$(clipcatctl --server-endpoint "$socket" length 2>/dev/null)"; then
    break
  fi
  count=''
  sleep 0.1
done
case "$count" in
  0) message='El historial está vacío. Copia algo con Ctrl+C.' ;;
  '') message='El servicio del portapapeles no responde.' ;;
esac
if [[ -n "${message:-}" ]]; then
  exec rofi -e "$message" -theme "$theme" -theme-str "$theme_override"
fi

sed "s|@RUNTIME_SOCKET@|$socket|" "$config_template" > "$runtime_config"
exec clipcat-menu --config "$runtime_config" --finder rofi \
  --rofi-extra-arguments="-theme,$theme,-theme-str,$theme_override"
