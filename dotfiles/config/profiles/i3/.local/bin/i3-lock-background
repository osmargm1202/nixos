#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/i3"
ffmpeg_bin="${I3_LOCK_BACKGROUND_FFMPEG_BIN:-ffmpeg}"
source_image="${1:-}"

if [[ "$source_image" == --clear ]]; then
  mkdir -p "$state_dir"
  rm -f -- "$state_dir/lock_screen"
  exit 0
fi

case "${source_image,,}" in
  *.jpg|*.jpeg|*.png|*.webp) ;;
  *)
    printf 'usage: %s IMAGE.jpg|IMAGE.jpeg|IMAGE.png|IMAGE.webp|--clear\n' "${0##*/}" >&2
    exit 2
    ;;
esac

source_image="$(readlink -f -- "$source_image")"
[[ -f "$source_image" ]] || {
  printf '%s: image does not exist: %s\n' "${0##*/}" "$source_image" >&2
  exit 1
}
command -v "$ffmpeg_bin" >/dev/null 2>&1 || {
  printf '%s: ffmpeg is required to prepare the lock image\n' "${0##*/}" >&2
  exit 1
}

target="$state_dir/lock_screen.png"
pointer="$state_dir/lock_screen"

mkdir -p "$state_dir"
temporary_image="$(mktemp "$state_dir/.lock_screen.XXXXXX.png")"
temporary_pointer="$(mktemp "$state_dir/.lock_screen-pointer.XXXXXX")"
cleanup() {
  rm -f -- "$temporary_image" "$temporary_pointer"
}
trap cleanup EXIT

"$ffmpeg_bin" -hide_banner -loglevel error -y -i "$source_image" -frames:v 1 "$temporary_image"
mv -f -- "$temporary_image" "$target"
printf '%s\n' "$target" >"$temporary_pointer"
mv -f -- "$temporary_pointer" "$pointer"
