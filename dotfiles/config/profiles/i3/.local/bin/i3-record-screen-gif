#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}/i3-screen-recording"
pid_file="$state_dir/gif.pid"
output_dir="$HOME/Pictures/Records"

stop_recording() {
  [[ -r "$pid_file" ]] || return 1
  read -r pid <"$pid_file" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  kill -TERM -- "-$pid"
}

if stop_recording; then
  exit 0
fi
rm -f "$pid_file"
mkdir -p "$state_dir" "$output_dir"

record_name="record-$(date '+%Y-%m-%d--%H:%M:%S')"
mp4_output="$output_dir/$record_name.mp4"
gif_output="$output_dir/$record_name.gif"
# The inner shell writes its post-setsid PID. That PID is the process-group
# leader even when util-linux `setsid` must fork before creating the session.
setsid bash -c 'printf "%s\n" "$$" >"$1"; shift; exec "$@"' bash "$pid_file" \
  ffcast -s % ffmpeg -y \
  -f x11grab -framerate 30 -video_size %s -i %D+%c \
  -c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p \
  "$mp4_output" &
pid=$!
dunstify 'Recording Started (GIF)' -t 2000

wait "$pid" || true
rm -f "$pid_file"

if [[ -s "$mp4_output" ]]; then
  ffmpeg -y -i "$mp4_output" "$gif_output"
  rm -f "$mp4_output"
  printf 'file://%s\n' "$gif_output" | xclip -selection clipboard -t text/uri-list
  dunstify 'Recording Stopped (GIF)' -t 2000
else
  rm -f "$mp4_output"
fi
