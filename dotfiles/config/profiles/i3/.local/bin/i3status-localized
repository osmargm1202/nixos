#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import threading
from pathlib import Path
import time

NORMAL = "#c0caf5"
CPU_WARNING = "#ff9e64"
RAM_WARNING = "#e0af68"
CRITICAL = "#f7768e"
CAFFEINE_ON = "#9ece6a"
CAFFEINE_OFF = "#565f89"
NETWORK = "#7aa2f7"
PICOM_EFFECTS_ON = "#bb9af7"
PICOM_EFFECTS_OFF = "#565f89"
ICON_KEYBOARD = ""
ICON_CAFFEINE_ON = ""
ICON_CAFFEINE_OFF = "󰅶"
ICON_PICOM_EFFECTS_ON = "✦"
ICON_PICOM_EFFECTS_OFF = "○"
ICON_CPU = ""
ICON_MEMORY = "󰍛"
ICON_DISK = "󰋊"
ICON_WIFI = ""
ICON_WIFI_OFF = "󰖪"
ICON_ETHERNET = "󰈀"
BATTERY_ICONS = ("", "", "", "", "", "", "", "", "", "", "")
BATTERY_CHARGING = ""
GIB = 1024**3
POWER_SUPPLY_PATH = Path(os.environ.get("I3_POWER_SUPPLY_PATH", "/sys/class/power_supply"))
DESKTOP_PROFILE_PATH = Path(os.environ.get("ORGM_DESKTOP_PROFILE_FILE", "/etc/orgm/desktop-profile"))
PICOM_EFFECTS_STATE = Path(
    os.environ.get("I3_PICOM_EFFECTS_STATE", Path.home() / ".local" / "state" / "i3" / "picom-effects-disabled")
)
DESKTOP_PROFILES = {
    "normal": ("NORMAL", NETWORK),
    "windows": ("WINDOWS", "#00a4ef"),
    "gaming": ("GAMING", CAFFEINE_ON),
}

TRANSLATIONS = (
    ("Monday ", "Lunes "),
    ("Tuesday ", "Martes "),
    ("Wednesday ", "Miércoles "),
    ("Thursday ", "Jueves "),
    ("Friday ", "Viernes "),
    ("Saturday ", "Sábado "),
    ("Sunday ", "Domingo "),
    (" - January - ", " - Enero - "),
    (" - February - ", " - Febrero - "),
    (" - March - ", " - Marzo - "),
    (" - April - ", " - Abril - "),
    (" - May - ", " - Mayo - "),
    (" - June - ", " - Junio - "),
    (" - July - ", " - Julio - "),
    (" - August - ", " - Agosto - "),
    (" - September - ", " - Septiembre - "),
    (" - October - ", " - Octubre - "),
    (" - November - ", " - Noviembre - "),
    (" - December - ", " - Diciembre - "),
)


def caffeine_enabled():
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return (state_home / "i3" / "caffeine").is_file()

def system_battery():
    readings = []
    for battery in sorted(POWER_SUPPLY_PATH.glob("BAT*")):
        try:
            percentage = int((battery / "capacity").read_text(encoding="ascii").strip())
            status = (battery / "status").read_text(encoding="ascii").strip()
        except (OSError, ValueError):
            continue
        readings.append((percentage, status))
    if not readings:
        return None
    percentage = round(sum(percentage for percentage, _ in readings) / len(readings))
    return percentage, any(status == "Charging" for _, status in readings)


def click_action(click):
    if click.get("button") != 1:
        return
    if click.get("name") == "caffeine":
        toggle = Path.home() / ".local" / "bin" / "i3-caffeine-toggle"
        subprocess.Popen(
            [str(toggle), "toggle"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif click.get("name") == "picom-effects":
        toggle = Path.home() / ".local" / "bin" / "i3-picom-effects"
        subprocess.Popen(
            [str(toggle), "toggle"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif click.get("name") == "keyboard":
        subprocess.Popen(["xkb-switch", "-n"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    elif click.get("name") == "orgm-status":
        helper = Path.home() / ".local" / "bin" / "orgm-status"
        try:
            subprocess.Popen(
                [str(helper), "open"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            pass



def battery_block(block):
    text = block.get("full_text", "")
    live_battery = system_battery()
    if live_battery is not None:
        percentage, charging = live_battery
    else:
        match = re.search(r"(\d+)%", text)
        if not match:
            return block
        percentage = int(match.group(1))
        charging = "CHR" in text.upper()
    icon = BATTERY_CHARGING if charging else BATTERY_ICONS[min(percentage // 10, len(BATTERY_ICONS) - 1)]
    block = block.copy()
    block["full_text"] = f"{icon} {percentage}%"
    block["color"] = CRITICAL if percentage <= 15 else CPU_WARNING if percentage <= 35 else NORMAL
    return block


def keyboard_block():
    try:
        result = subprocess.run(
            ["xkb-switch", "-p"],
            capture_output=True,
            check=True,
            text=True,
            timeout=1,
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return None
    layout = result.stdout.strip().split("(", 1)[0].upper()
    if not layout:
        return None
    return {"name": "keyboard", "full_text": f"{ICON_KEYBOARD} {layout}", "color": NORMAL}



def picom_effects_block():
    enabled = not PICOM_EFFECTS_STATE.is_file()
    return {
        "name": "picom-effects",
        "instance": "enabled" if enabled else "disabled",
        "full_text": ICON_PICOM_EFFECTS_ON if enabled else ICON_PICOM_EFFECTS_OFF,
        "color": PICOM_EFFECTS_ON if enabled else PICOM_EFFECTS_OFF,
    }
def resource_blocks(cpu_percent, mem_total_kib, mem_available_kib, disk_available_bytes, caffeine_on):
    cpu_color = CRITICAL if cpu_percent > 90 else CPU_WARNING if cpu_percent >= 75 else NORMAL
    memory_used_percent = 100 * (mem_total_kib - mem_available_kib) / mem_total_kib
    ram_color = CRITICAL if memory_used_percent >= 90 else RAM_WARNING if memory_used_percent > 50 else NORMAL
    return [
        {
            "name": "caffeine",
            "full_text": ICON_CAFFEINE_ON if caffeine_on else ICON_CAFFEINE_OFF,
            "color": CAFFEINE_ON if caffeine_on else CAFFEINE_OFF,
        },
        {
            "name": "cpu",
            "full_text": f"{ICON_CPU} {cpu_percent:d}%",
            "color": cpu_color,
        },
        {
            "name": "memory",
            "full_text": f"{ICON_MEMORY} {mem_available_kib * 1024 / GIB:.2f} GiB",
            "color": ram_color,
        },
        {
            "name": "disk",
            "full_text": f"{ICON_DISK} {disk_available_bytes / GIB:.0f} GiB",
            "color": NORMAL,
        },
    ]


def cpu_sample():
    with open("/proc/stat", encoding="ascii") as stat_file:
        fields = [int(value) for value in stat_file.readline().split()[1:]]
    return sum(fields), fields[3] + fields[4]


def memory_sample():
    values = {}
    with open("/proc/meminfo", encoding="ascii") as meminfo:
        for line in meminfo:
            key, value, *_ = line.split()
            if key in {"MemTotal:", "MemAvailable:"}:
                values[key] = int(value)
    return values["MemTotal:"], values["MemAvailable:"]


def disk_available_bytes():
    filesystem = os.statvfs("/")
    return filesystem.f_bavail * filesystem.f_frsize


class CpuUsage:
    def __init__(self):
        self.previous_total, self.previous_idle = cpu_sample()

    def percent(self):
        total, idle = cpu_sample()
        total_delta = total - self.previous_total
        idle_delta = idle - self.previous_idle
        self.previous_total, self.previous_idle = total, idle
        if total_delta <= 0:
            return 0
        return round(100 * (total_delta - idle_delta) / total_delta)


class InfrastructureStatus:
    def __init__(self):
        self.block = {
            "name": "orgm-status",
            "instance": "summary",
            "full_text": (
                '<span foreground="#f87171">N </span> '
                '<span foreground="#f87171">F </span> '
                '<span foreground="#f87171">V </span> '
                '<span foreground="#f87171">O </span> '
                '<span foreground="#565f89">│</span> '
            ),
            "markup": "pango",
            "separator": False,
            "separator_block_width": 0,
        }
        self.last_update = 0.0

    def current(self):
        now = time.monotonic()
        if now - self.last_update >= 5:
            self.last_update = now
            helper = Path.home() / ".local" / "bin" / "orgm-status"
            try:
                result = subprocess.run(
                    [str(helper), "i3bar"],
                    capture_output=True,
                    check=True,
                    text=True,
                    timeout=2,
                )
                candidate = json.loads(result.stdout)
                if candidate.get("name") == "orgm-status":
                    self.block = candidate
            except (
                OSError,
                subprocess.CalledProcessError,
                subprocess.TimeoutExpired,
                json.JSONDecodeError,
            ):
                pass
        return self.block.copy()

def desktop_profile_block():
    try:
        profile = DESKTOP_PROFILE_PATH.read_text(encoding="utf-8").strip().lower()
    except OSError:
        profile = "normal"
    label, color = DESKTOP_PROFILES.get(profile, DESKTOP_PROFILES["normal"])
    return {
        "name": "desktop-profile",
        "instance": profile,
        "full_text": (
            f'<span foreground="{color}">[{label}]</span> '
            '<span foreground="#565f89">│</span> '
        ),
        "markup": "pango",
        "separator": False,
        "separator_block_width": 0,
    }


def localize(block):
    if "full_text" not in block:
        return block
    block = block.copy()
    for english, spanish in TRANSLATIONS:
        block["full_text"] = block["full_text"].replace(english, spanish)
    name = block.get("name", "")
    if name.startswith("battery"):
        return battery_block(block)
    if name == "wireless":
        if block["full_text"].endswith("down"):
            block["full_text"] = ICON_WIFI_OFF
            block["color"] = CRITICAL
        else:
            block["full_text"] = f"{ICON_WIFI} {block['full_text']}".rstrip()
            block["color"] = NETWORK
    elif name == "ethernet":
        if block["full_text"].endswith("down"):
            block["full_text"] = ICON_ETHERNET
            block["color"] = CRITICAL
        else:
            block["full_text"] = f"{ICON_ETHERNET} {block['full_text']}".rstrip()
            block["color"] = NETWORK
    return block


def decorate(blocks, cpu_usage, infrastructure_status):
    localized = [localize(block) for block in blocks]
    regular = [block for block in localized if block.get("name") != "tztime"]
    clock = [block for block in localized if block.get("name") == "tztime"]
    keyboard = keyboard_block()
    if keyboard is not None:
        regular.append(keyboard)
    total_kib, available_kib = memory_sample()
    return [desktop_profile_block(), infrastructure_status.current()] + regular + [picom_effects_block()] + resource_blocks(
        cpu_usage.percent(),
        total_kib,
        available_kib,
        disk_available_bytes(),
        caffeine_enabled(),
    ) + clock


def handle_clicks():
    for line in sys.stdin:
        event = line.strip().lstrip(",")
        if not event or event in {"[", "]"}:
            continue
        try:
            click = json.loads(event)
        except json.JSONDecodeError:
            continue
        click_action(click)


def main():
    threading.Thread(target=handle_clicks, daemon=True).start()
    status = subprocess.Popen(
        ["i3status", "-c", str(Path.home() / ".config" / "i3" / "i3status.conf")],
        env={**os.environ, "LC_TIME": "C"},
        stdout=subprocess.PIPE,
        text=True,
    )
    cpu_usage = CpuUsage()
    infrastructure_status = InfrastructureStatus()
    wrote_header = False
    wrote_array = False
    first_update = True

    assert status.stdout is not None
    for raw_line in status.stdout:
        line = raw_line.strip()
        if not line:
            continue
        if line.startswith("{") and not wrote_header:
            print('{"version":1,"click_events":true}', flush=True)
            wrote_header = True
        elif line == "[" and not wrote_array:
            print("[", flush=True)
            wrote_array = True
        elif line != "]":
            blocks = decorate(json.loads(line.lstrip(",")), cpu_usage, infrastructure_status)
            prefix = "" if first_update else ","
            print(f"{prefix}{json.dumps(blocks, ensure_ascii=False, separators=(',', ':'))}", flush=True)
            first_update = False

    status.wait()
    return status.returncode


if __name__ == "__main__":
    sys.exit(main())
