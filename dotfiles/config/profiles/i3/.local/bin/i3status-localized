#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

NORMAL = "#c0caf5"
CPU_WARNING = "#ff9e64"
RAM_WARNING = "#e0af68"
CRITICAL = "#f7768e"
CAFFEINE_ON = "#9ece6a"
CAFFEINE_OFF = "#565f89"
NETWORK = "#7aa2f7"
PICOM_EFFECTS_ON = "#bb9af7"
PICOM_EFFECTS_OFF = "#565f89"
ICON_KEYBOARD = ""
ICON_CAFFEINE_ON = ""
ICON_CAFFEINE_OFF = "󰅶"
ICON_PICOM_EFFECTS_ON = "✦"
ICON_PICOM_EFFECTS_OFF = "○"
ICON_CPU = ""
ICON_MEMORY = "󰍛"
ICON_DISK = "󰋊"
ICON_WIFI = ""
ICON_WIFI_OFF = "󰖪"
ICON_ETHERNET = "󰈀"
BATTERY_ICONS = ("", "", "", "", "", "", "", "", "", "", "")
BATTERY_CHARGING = ""
GIB = 1024**3
POWER_SUPPLY_PATH = Path(os.environ.get("I3_POWER_SUPPLY_PATH", "/sys/class/power_supply"))
PICOM_EFFECTS_STATE = Path(
    os.environ.get("I3_PICOM_EFFECTS_STATE", Path.home() / ".local" / "state" / "i3" / "picom-effects-disabled")
)
TRANSLATIONS = (
    ("Monday ", "Lunes "), ("Tuesday ", "Martes "), ("Wednesday ", "Miércoles "),
    ("Thursday ", "Jueves "), ("Friday ", "Viernes "), ("Saturday ", "Sábado "),
    ("Sunday ", "Domingo "), (" - January - ", " - Enero - "),
    (" - February - ", " - Febrero - "), (" - March - ", " - Marzo - "),
    (" - April - ", " - Abril - "), (" - May - ", " - Mayo - "),
    (" - June - ", " - Junio - "), (" - July - ", " - Julio - "),
    (" - August - ", " - Agosto - "), (" - September - ", " - Septiembre - "),
    (" - October - ", " - Octubre - "), (" - November - ", " - Noviembre - "),
    (" - December - ", " - Diciembre - "),
)


def caffeine_enabled():
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return (state_home / "i3" / "caffeine").is_file()


def system_battery():
    readings = []
    for battery in sorted(POWER_SUPPLY_PATH.glob("BAT*")):
        try:
            percentage = int((battery / "capacity").read_text(encoding="ascii").strip())
            status = (battery / "status").read_text(encoding="ascii").strip()
        except (OSError, ValueError):
            continue
        readings.append((percentage, status))
    if not readings:
        return None
    percentage = round(sum(percentage for percentage, _ in readings) / len(readings))
    return percentage, any(status == "Charging" for _, status in readings)


def click_action(click):
    if click.get("button") != 1:
        return
    helper = Path.home() / ".local" / "bin"
    if click.get("name") == "caffeine":
        command = [str(helper / "i3-caffeine-toggle"), "toggle"]
    elif click.get("name") == "picom-effects":
        command = [str(helper / "i3-picom-effects"), "toggle"]
    elif click.get("name") == "keyboard":
        command = ["xkb-switch", "-n"]
    else:
        return
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def battery_block(block):
    live_battery = system_battery()
    if live_battery is not None:
        percentage, charging = live_battery
    else:
        match = re.search(r"(\d+)%", block.get("full_text", ""))
        if not match:
            return block
        percentage, charging = int(match.group(1)), "CHR" in block["full_text"].upper()
    block = block.copy()
    block["full_text"] = f"{BATTERY_CHARGING if charging else BATTERY_ICONS[min(percentage // 10, len(BATTERY_ICONS) - 1)]} {percentage}%"
    block["color"] = CRITICAL if percentage <= 15 else CPU_WARNING if percentage <= 35 else NORMAL
    return block


def keyboard_block():
    try:
        result = subprocess.run(["xkb-switch", "-p"], capture_output=True, check=True, text=True, timeout=1)
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return None
    layout = result.stdout.strip().split("(", 1)[0].upper()
    return {"name": "keyboard", "full_text": f"{ICON_KEYBOARD} {layout}", "color": NORMAL} if layout else None


def picom_effects_block():
    enabled = not PICOM_EFFECTS_STATE.is_file()
    return {"name": "picom-effects", "instance": "enabled" if enabled else "disabled", "full_text": ICON_PICOM_EFFECTS_ON if enabled else ICON_PICOM_EFFECTS_OFF, "color": PICOM_EFFECTS_ON if enabled else PICOM_EFFECTS_OFF}


def cpu_sample():
    with open("/proc/stat", encoding="ascii") as stat_file:
        fields = [int(value) for value in stat_file.readline().split()[1:]]
    return sum(fields), fields[3] + fields[4]


def memory_sample():
    values = {}
    with open("/proc/meminfo", encoding="ascii") as meminfo:
        for line in meminfo:
            key, value, *_ = line.split()
            if key in {"MemTotal:", "MemAvailable:"}:
                values[key] = int(value)
    return values["MemTotal:"], values["MemAvailable:"]


class CpuUsage:
    def __init__(self):
        self.previous_total, self.previous_idle = cpu_sample()

    def percent(self):
        total, idle = cpu_sample()
        total_delta, idle_delta = total - self.previous_total, idle - self.previous_idle
        self.previous_total, self.previous_idle = total, idle
        return 0 if total_delta <= 0 else round(100 * (total_delta - idle_delta) / total_delta)


def localize(block):
    if "full_text" not in block:
        return block
    block = block.copy()
    for english, spanish in TRANSLATIONS:
        block["full_text"] = block["full_text"].replace(english, spanish)
    if block.get("name", "").startswith("battery"):
        return battery_block(block)
    if block.get("name") == "wireless":
        if block["full_text"].endswith("down"):
            block["full_text"], block["color"] = ICON_WIFI_OFF, CRITICAL
        else:
            block["full_text"], block["color"] = f"{ICON_WIFI} {block['full_text']}".rstrip(), NETWORK
    elif block.get("name") == "ethernet":
        if block["full_text"].endswith("down"):
            block["full_text"], block["color"] = ICON_ETHERNET, CRITICAL
        else:
            block["full_text"], block["color"] = f"{ICON_ETHERNET} {block['full_text']}".rstrip(), NETWORK
    return block


def decorate(blocks, cpu_usage):
    regular = [localize(block) for block in blocks if block.get("name") != "tztime"]
    clock = [localize(block) for block in blocks if block.get("name") == "tztime"]
    keyboard = keyboard_block()
    if keyboard is not None:
        regular.append(keyboard)
    total_kib, available_kib = memory_sample()
    resources = [
        {"name": "caffeine", "full_text": ICON_CAFFEINE_ON if caffeine_enabled() else ICON_CAFFEINE_OFF, "color": CAFFEINE_ON if caffeine_enabled() else CAFFEINE_OFF},
        {"name": "cpu", "full_text": f"{ICON_CPU} {cpu_usage.percent():d}%", "color": NORMAL},
        {"name": "memory", "full_text": f"{ICON_MEMORY} {available_kib * 1024 / GIB:.2f} GiB", "color": NORMAL},
        {"name": "disk", "full_text": f"{ICON_DISK} {os.statvfs('/').f_bavail * os.statvfs('/').f_frsize / GIB:.0f} GiB", "color": NORMAL},
    ]
    resources[1]["color"] = CRITICAL if int(resources[1]["full_text"].split()[-1][:-1]) > 90 else CPU_WARNING if int(resources[1]["full_text"].split()[-1][:-1]) >= 75 else NORMAL
    memory_used = 100 * (total_kib - available_kib) / total_kib
    resources[2]["color"] = CRITICAL if memory_used >= 90 else RAM_WARNING if memory_used > 50 else NORMAL
    return regular + [picom_effects_block()] + resources + clock


def handle_clicks():
    for line in sys.stdin:
        event = line.strip().lstrip(",")
        if event and event not in {"[", "]"}:
            try:
                click_action(json.loads(event))
            except json.JSONDecodeError:
                pass


def main():
    threading.Thread(target=handle_clicks, daemon=True).start()
    status = subprocess.Popen(["i3status", "-c", str(Path.home() / ".config" / "i3" / "i3status.conf")], env={**os.environ, "LC_TIME": "C"}, stdout=subprocess.PIPE, text=True)
    cpu_usage, wrote_header, wrote_array, first_update = CpuUsage(), False, False, True
    assert status.stdout is not None
    for raw_line in status.stdout:
        line = raw_line.strip()
        if not line:
            continue
        if line.startswith("{") and not wrote_header:
            print('{"version":1,"click_events":true}', flush=True)
            wrote_header = True
        elif line == "[" and not wrote_array:
            print("[", flush=True)
            wrote_array = True
        elif line != "]":
            prefix = "" if first_update else ","
            print(f"{prefix}{json.dumps(decorate(json.loads(line.lstrip(',')), cpu_usage), ensure_ascii=False, separators=(',', ':'))}", flush=True)
            first_update = False
    return status.wait()


if __name__ == "__main__":
    sys.exit(main())
