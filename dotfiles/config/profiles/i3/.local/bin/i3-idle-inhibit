#!/usr/bin/env bash
set -euo pipefail

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/i3/caffeine"
inhibitor_pid=""
interval="${I3_IDLE_INHIBIT_INTERVAL:-5}"

start_inhibitor() {
  [[ -n "$inhibitor_pid" ]] && kill -0 "$inhibitor_pid" 2>/dev/null && return
  systemd-inhibit \
    --what=idle \
    --mode=block \
    --why="i3 caffeine mode" \
    sleep infinity >/dev/null 2>&1 &
  inhibitor_pid=$!
}

stop_inhibitor() {
  [[ -n "$inhibitor_pid" ]] || return 0
  kill "$inhibitor_pid" 2>/dev/null || true
  wait "$inhibitor_pid" 2>/dev/null || true
  inhibitor_pid=""
}

cleanup() {
  stop_inhibitor
}
trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM

while :; do
  if [[ -f "$state_file" ]]; then
    start_inhibitor
  else
    stop_inhibitor
  fi
  sleep "$interval"
done
