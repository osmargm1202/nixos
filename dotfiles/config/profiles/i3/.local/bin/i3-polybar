#!/usr/bin/env bash
set -euo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/polybar"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/polybar-themes"
upstream="$config_root/upstream"
simple="$upstream/simple"
themes_runtime="$state_root/themes"
revision_file="$state_root/upstream-revision"
render_version_file="$state_root/render-version"
render_version=9
selection_file="$state_root/current"
font_destination="$HOME/.local/share/fonts/adi1090x-polybar-themes"
upstream_url="https://github.com/adi1090x/polybar-themes.git"
themes=(blocks colorblocks cuts docky forest grayblocks hack material panels pwidgets shades shapes)
panel_styles=(budgie deepin elementary elementary_dark gnome kde kde_dark liri mint ubuntu_gnome ubuntu_unity xubuntu zorin)

fail() {
  printf 'i3-polybar: %s\n' "$*" >&2
  exit 1
}

managed_link() {
  local target="$1" source="$2" legacy_source="${3:-}" actual_source

  if [[ -e "$target" || -L "$target" ]]; then
    [[ -L "$target" ]] || fail "$target exists and is not managed by the upstream Polybar checkout"
    actual_source="$(readlink "$target")"
    if [[ "$actual_source" != "$source" && \
      ( -z "$legacy_source" || "$actual_source" != "$legacy_source" ) ]]; then
      fail "$target exists and is not managed by the upstream Polybar checkout"
    fi
  fi
  ln -sfn "$source" "$target"
}

cleanup_eww() {
  local eww_root="${XDG_CONFIG_HOME:-$HOME/.config}/eww"
  local eww_upstream="$eww_root/upstream"

  [[ -d "$eww_upstream/.git" ]] || return 0
  [[ "$(git -C "$eww_upstream" remote get-url origin 2>/dev/null || true)" == \
    "https://github.com/Saimoomedits/eww-widgets.git" ]] || return 0

  pkill -x eww 2>/dev/null || true
  if [[ -L "$eww_root/bar" && "$(readlink "$eww_root/bar")" == "upstream/eww/bar" ]]; then
    rm "$eww_root/bar"
  fi
  rm -rf "$eww_upstream"
  rmdir "$eww_root" 2>/dev/null || true
}
scale_font_file() {
  local config="$1" temporary_file line

  temporary_file="$(mktemp "$config.tmp.XXXXXX")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^([[:space:]]*font-[0-9]+[[:space:]]*=[[:space:]]*.*)(pixelsize|size)=([0-9]+)(.*)$ ]]; then
      printf '%s%s=%s%s\n' \
        "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$((BASH_REMATCH[3] + 2))" "${BASH_REMATCH[4]}"
    else
      printf '%s\n' "$line"
    fi
  done < "$config" > "$temporary_file"
  mv "$temporary_file" "$config"
}

prepare_theme() {
  local theme="$1" theme_dir="$2" config

  shopt -s globstar nullglob
  for config in "$theme_dir"/**/*.ini; do
    scale_font_file "$config"
  done
  shopt -u globstar nullglob
  if [[ "$theme" == pwidgets ]]; then
    sed -i 's#killall -q polybar#pkill -x polybar 2>/dev/null || true#' "$theme_dir/launch.sh"
  fi
  enable_tray_module "$theme" "$theme_dir"
}
enable_tray_module() {
  local theme="$1" theme_dir="$2" config module_list

  case "$theme" in
    pwidgets) config="$theme_dir/main.ini"; module_list='modules-center' ;;
    cuts | hack) config="$theme_dir/config.ini"; module_list='modules-right' ;;
    *) config="$theme_dir/config.ini"; module_list='modules-right' ;;
  esac

  sed -i '/^tray-/d' "$config"
  case "$theme" in
    pwidgets)
      sed -i '/^\[bar\/top\]$/,/^\[bar\// { /^modules-center = / s/$/ i3-tray/ }' "$config"
      ;;
    cuts | hack)
      sed -i '/^\[bar\/top\]$/,/^\[bar\// { /^modules-right = / s/$/ i3-tray/ }' "$config"
      ;;
    *)
      sed -i '/^\[bar\/main\]$/,/^\[bar\// { /^modules-right = / s/$/ i3-tray/ }' "$config"
      ;;
  esac
  grep -Eq "^${module_list} = .*i3-tray$" "$config" ||
    fail "cannot add the system tray to $theme"
  cat >> "$config" <<'EOF'

[module/i3-tray]
type = internal/tray
format-margin = 4pt
tray-spacing = 4pt
tray-size = 75%
EOF
}



sync_upstream() {
  local revision previous_revision theme

  install -d "$config_root" "$state_root"
  if [[ -d "$upstream/.git" ]]; then
    if ! git -C "$upstream" fetch --depth 1 origin master; then
      printf '%s\n' 'i3-polybar: unable to refresh themes; using the existing checkout' >&2
    else
      git -C "$upstream" reset --hard FETCH_HEAD
    fi
  elif [[ -e "$upstream" ]]; then
    fail "$upstream exists but is not the adi1090x/polybar-themes checkout"
  else
    git clone --depth 1 --branch master "$upstream_url" "$upstream"
  fi

  [[ -d "$simple" ]] || fail "upstream checkout has no simple theme collection"
  revision="$(git -C "$upstream" rev-parse HEAD)"
  previous_revision="$(cat "$revision_file" 2>/dev/null || true)"
  if [[ "$revision" != "$previous_revision" || ! -d "$themes_runtime" || \
    "$(cat "$render_version_file" 2>/dev/null || true)" != "$render_version" ]]; then
    rm -rf "$themes_runtime"
    install -d "$themes_runtime"
    for theme in "${themes[@]}"; do
      cp -a "$simple/$theme" "$themes_runtime/$theme"
      prepare_theme "$theme" "$themes_runtime/$theme"
    done
    install -d "$font_destination"
    cp -a "$upstream/fonts/." "$font_destination"
    fc-cache -f "$font_destination"
    printf '%s\n' "$revision" > "$revision_file"
    printf '%s\n' "$render_version" > "$render_version_file"
  fi

  for theme in "${themes[@]}"; do
    if [[ "$theme" == panels ]]; then
      managed_link "$config_root/$theme" "$themes_runtime/$theme" "$state_root/panels"
    else
      managed_link "$config_root/$theme" "$themes_runtime/$theme" "upstream/simple/$theme"
    fi
  done

  cleanup_eww
}

selected_theme() {
  local theme panel_style
  theme="$(cat "$selection_file" 2>/dev/null || printf panels)"
  for candidate in "${themes[@]}"; do
    [[ "$theme" == "$candidate" ]] && {
      printf '%s\n' "$theme"
      return
    }
  done
  if [[ "$theme" == panels:* ]]; then
    panel_style="${theme#panels:}"
    for candidate in "${panel_styles[@]}"; do
      [[ "$panel_style" == "$candidate" ]] && {
        printf '%s\n' "$theme"
        return
      }
    done
  fi
  printf '%s\n' panels
}

render_panel() {
  local style="$1" config="$config_root/panels/config.ini"
  local battery="" adapter="" interface="" supply type

  [[ -f "$config_root/panels/panel/$style.ini" ]] || fail "unknown panels style: $style"
  cp "$config_root/panels/panel/$style.ini" "$config"
  sed -i \
    -e '/^click-left = .*style-switch\.sh --/c\click-left = $HOME/.local/bin/i3-polybar-theme select' \
    -e '/^click-right = .*style-switch\.sh --/c\click-right = $HOME/.local/bin/i3-polybar-theme select' \
    -e 's#^click-left  = termite &$#click-left  = kitty \&#' \
    -e 's#^click-left  = firefox &$#click-left  = $HOME/.local/bin/i3-zen-new-window \&#' \
    -e 's#^click-left  = thunar &$#click-left  = nautilus --new-window "$HOME" \&#' \
    -e 's#^click-left  = xfce4-settings &$#click-left  = lxappearance \&#' \
    "$config"

  for supply in /sys/class/power_supply/*; do
    [[ -r "$supply/type" ]] || continue
    type="$(<"$supply/type")"
    case "$type" in
      Battery) battery="${supply##*/}" ;;
      Mains) adapter="${supply##*/}" ;;
    esac
  done
  if [[ -n "$battery" ]]; then
    sed -i -e "s/^battery = BAT1$/battery = $battery/" -e "s/^adapter = ACAD$/adapter = ${adapter:-AC}/" "$config"
  else
    sed -i 's/modules-right = style network alsa battery date sysmenu/modules-right = style network alsa date sysmenu/' "$config"
  fi

  interface="$(ip route show default 2>/dev/null | awk 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
  if [[ -n "$interface" ]]; then
    sed -i "s/^interface = wlan0$/interface = $interface/" "$config"
  else
    sed -i 's/modules-right = style network alsa battery date sysmenu/modules-right = style alsa battery date sysmenu/' "$config"
    sed -i 's/modules-right = style network alsa date sysmenu/modules-right = style alsa date sysmenu/' "$config"
  fi
  enable_tray_module panels "$config_root/panels"
}

launch_theme() {
  local theme="$1"

  pkill -x polybar 2>/dev/null || true
  while pgrep -u "$UID" -x polybar >/dev/null; do sleep 0.1; done

  case "$theme" in
    panels)
      render_panel zorin
      polybar -q main -c "$config_root/panels/config.ini" &
      ;;
    panels:*)
      render_panel "${theme#panels:}"
      polybar -q main -c "$config_root/panels/config.ini" &
      ;;
    hack | cuts)
      polybar -q top -c "$config_root/$theme/config.ini" &
      polybar -q bottom -c "$config_root/$theme/config.ini" &
      ;;
    pwidgets)
      bash "$config_root/pwidgets/launch.sh" --main
      ;;
    *)
      polybar -q main -c "$config_root/$theme/config.ini" &
      ;;
  esac
}

case "${1:-start}" in
  sync)
    sync_upstream
    ;;
  start)
    if [[ "${2:-}" != --no-sync ]]; then
      sync_upstream
    fi
    launch_theme "$(selected_theme)"
    ;;
  *)
    fail "usage: i3-polybar [sync|start [--no-sync]]"
    ;;
esac
