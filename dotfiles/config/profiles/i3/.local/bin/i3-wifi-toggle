#!/usr/bin/env bash
set -euo pipefail

state="$(nmcli radio wifi)"
case "$state" in
  enabled)
    nmcli radio wifi off
    message='Wi-Fi disabled'
    ;;
  disabled)
    nmcli radio wifi on
    message='Wi-Fi enabled'
    ;;
  *)
    notify-send 'Wi-Fi' "Unknown radio state: $state" 2>/dev/null || true
    exit 1
    ;;
esac

notify-send -a 'i3-wifi' -t 1200 'Wi-Fi' "$message" 2>/dev/null || true
