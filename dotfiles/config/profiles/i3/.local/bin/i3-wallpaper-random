#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="${I3_WALLPAPER_DIR:-$HOME/.config/wallpapers}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/i3"
state_file="$state_dir/wallpaper"
mode="${1:-random}"

notify_missing() {
  command -v notify-send >/dev/null 2>&1 && notify-send 'i3 wallpaper' "No hay imágenes en $wallpaper_dir" || true
}

wallpaper=''
if [[ "$mode" == --restore && -f "$state_file" ]]; then
  wallpaper="$(cat "$state_file")"
  [[ -f "$wallpaper" ]] || wallpaper=''
fi

if [[ -z "$wallpaper" ]]; then
  mapfile -d '' images < <(find "$wallpaper_dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 2>/dev/null)
  ((${#images[@]} > 0)) || { notify_missing; exit 0; }
  wallpaper="$(printf '%s\n' "${images[@]}" | shuf -n1)"
fi

feh --no-fehbg --bg-fill "$wallpaper"
mkdir -p "$state_dir"
printf '%s\n' "$wallpaper" > "$state_file"
