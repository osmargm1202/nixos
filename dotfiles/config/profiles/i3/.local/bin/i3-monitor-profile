#!/usr/bin/env bash
set -euo pipefail

quiet=0

notify() {
  ((quiet)) || notify-send -a 'i3-displays' -t 1800 'Displays' "$1" 2>/dev/null || true
}

restore_wallpaper() {
  i3-wallpaper --restore >/dev/null 2>&1 || notify 'Monitor restored, but wallpaper restore failed'
}

connected_outputs() {
  local output state rest
  while read -r output state rest; do
    [[ "$state" == connected ]] && printf '%s\n' "$output"
  done < <(xrandr --query)
}

is_internal_output() {
  [[ "$1" =~ ^(eDP|LVDS|DSI)(-|[0-9]) ]]
}

apply_external_fallback() {
  local -a outputs args
  local output primary='' previous

  mapfile -t outputs < <(connected_outputs)
  ((${#outputs[@]} > 0)) || return 1

  for output in "${outputs[@]}"; do
    if ! is_internal_output "$output"; then
      primary="$output"
      break
    fi
  done
  [[ -n "$primary" ]] || primary="${outputs[0]}"

  args=(--output "$primary" --auto --primary --pos 0x0)
  previous="$primary"
  for output in "${outputs[@]}"; do
    [[ "$output" == "$primary" ]] && continue
    args+=(--output "$output" --auto --right-of "$previous")
    previous="$output"
  done

  xrandr "${args[@]}"
}

apply_profile() {
  local detected='' status=0
  detected="$(autorandr --detected --match-edid 2>/dev/null || true)"

  if [[ -n "$detected" ]] && autorandr --change --force --match-edid; then
    notify 'Monitor profile restored'
  elif apply_external_fallback; then
    notify 'No usable monitor profile; external display selected as primary'
  else
    notify 'Could not restore or generate a monitor layout'
    status=1
  fi
  restore_wallpaper
  return "$status"
}

save_profile() {
  local profile="${1:-}"
  if [[ -z "$profile" ]]; then
    profile="$(printf '' | i3-rofi 'Save monitor profile' 3 || true)"
  fi
  [[ -n "$profile" ]] || return 0
  if [[ ! "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    notify 'Profile names may use letters, numbers, dot, underscore and dash'
    return 2
  fi
  local error
  if ! error="$(autorandr --save "$profile" --force 2>&1)"; then
    notify "Could not save $profile: ${error:-unknown error}"
    return 1
  fi
  notify "Saved profile: $profile"
}

load_profile() {
  local profile="${1:-}"
  if [[ -z "$profile" ]]; then
    profile="$(autorandr 2>/dev/null \
      | sed -E 's/^[[:space:]]+//; s/[[:space:]]+\(.*$//' \
      | sed '/^$/d' \
      | i3-rofi 'Load monitor profile' 10 || true)"
  fi
  [[ -n "$profile" ]] || return 0
  local error
  if ! error="$(autorandr --load "$profile" --force 2>&1)"; then
    notify "Could not load $profile: ${error:-unknown error}"
    return 1
  fi
  restore_wallpaper
  notify "Loaded profile: $profile"
}

case "${1:-}" in
  --apply)
    case "${2:-}" in
      '') ;;
      --quiet) quiet=1 ;;
      *) printf 'usage: %s [--apply [--quiet]|--save NAME|--load NAME|--list]\n' "${0##*/}" >&2; exit 2 ;;
    esac
    apply_profile
    ;;
  --save) save_profile "${2:-}" ;;
  --load) load_profile "${2:-}" ;;
  --list) exec autorandr ;;
  '')
    choice="$(printf '%s\n' Configure 'Apply detected' 'Save current' 'Load saved' Back \
      | i3-rofi Displays 5 || true)"
    case "$choice" in
      Configure) exec arandr ;;
      'Apply detected') apply_profile ;;
      'Save current') save_profile ;;
      'Load saved') load_profile ;;
      Back) exec i3-devices-menu ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    printf 'usage: %s [--apply [--quiet]|--save NAME|--load NAME|--list]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
