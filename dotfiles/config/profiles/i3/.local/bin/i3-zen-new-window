#!/usr/bin/env bash
set -euo pipefail

find_zen_window() {
  command -v i3-msg >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  i3-msg -t get_tree 2>/dev/null | jq -r '
    def children: [(.nodes[]?, .floating_nodes[]?)];
    def focus_children:
      . as $parent
      | ($parent.focus // []) as $order
      | children
      | sort_by(.id as $id | (($order | index($id)) // 999999));
    def focus_walk:
      ., (focus_children[] | focus_walk);
    first(
      focus_walk
      | select(.window_properties? != null)
      | select(
          (.window_properties.class // "") == "app.zen_browser.zen"
          or (.window_properties.class // "") == "zen-browser"
        )
    ).id // empty
  '
}

launch_zen() {
  local -a args=("$@")
  local browser
  if command -v flatpak >/dev/null 2>&1 && flatpak info app.zen_browser.zen >/dev/null 2>&1; then
    flatpak run app.zen_browser.zen "${args[@]}" >/dev/null 2>&1 &
    return 0
  fi
  for browser in zen-browser zen; do
    if command -v "$browser" >/dev/null 2>&1; then
      "$browser" "${args[@]}" >/dev/null 2>&1 &
      return 0
    fi
  done
  notify-send 'Zen Browser' 'Zen Browser is not installed' 2>/dev/null || true
  return 1
}

con_id="$(find_zen_window)"
if [[ -n "$con_id" ]]; then
  launch_zen --new-tab about:blank
else
  launch_zen
fi

for _ in {1..20}; do
  con_id="$(find_zen_window)"
  if [[ -n "$con_id" ]]; then
    i3-msg "[con_id=$con_id] focus" >/dev/null 2>&1 || true
    exit 0
  fi
  sleep 0.1
done
