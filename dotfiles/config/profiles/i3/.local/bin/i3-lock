#!/usr/bin/env bash
set -euo pipefail

exec i3lock-color --color=13182dff --clock --indicator \
  --time-color=e2e8f0ff --date-color=94a3b8ff \
  --greeter-text=BLOQUEADO --greeter-color=c4b5fdff --no-modkey-text \
  --bar-indicator --bar-orientation=horizontal --bar-direction=2 \
  --bar-count=20 --bar-total-width=440 --bar-max-height=40 \
  --bar-base-width=2 --bar-step=8 --bar-color=475569ff \
  --keyhl-color=38bdf8ff --bshl-color=fb7185ff --separator-color=00000000 \
  --ringver-color=e9d5ffff --ringwrong-color=fb7185ff -e "$@"
