#!/usr/bin/env bash
set -euo pipefail
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/i3"
lock_state="$state_dir/lock_screen"

if [[ -r "$lock_state" ]]; then
  IFS= read -r lock_image <"$lock_state" || lock_image=''
  if [[ -n "$lock_image" && -f "$lock_image" ]]; then
    exec i3lock-color -i "$lock_image" -e "$@"
  fi
fi

exec i3lock-color -c 2e3440 -e "$@"
