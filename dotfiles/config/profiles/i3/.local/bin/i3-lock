#!/usr/bin/env bash
set -euo pipefail

exec i3lock-color --color=0f172aff --clock --force-clock --indicator \
  --time-size=72 --date-size=18 --time-color=bfdbfeff --date-color=7dd3fcff \
  --time-pos=x+w/2:y+h/2-180 --date-pos=tx:ty+52 \
  --ind-pos=x+w/2:y+h/2+70 --radius=85 --ring-width=8 \
  --inside-color=172554ff --ring-color=60a5faff --line-color=00000000 \
  --insidever-color=1e3a8aff --ringver-color=bae6fdff \
  --insidewrong-color=3b1d36ff --ringwrong-color=fda4afff \
  --keyhl-color=7dd3fcff --bshl-color=fda4afff --separator-color=00000000 \
  --wrong-text='Clave incorrecta' --noinput-text='' --no-modkey-text -e "$@"
