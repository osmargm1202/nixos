#!/usr/bin/env bash
set -euo pipefail

# Skip this wrapper and execute the next Codex binary on PATH.
while IFS= read -r candidate; do
  [[ $candidate -ef $0 ]] && continue
  exec "$candidate" --yolo "$@"
done < <(type -aP codex)

printf '%s\n' 'codex: executable not found outside ~/.local/bin' >&2
exit 127
