#!/usr/bin/env python3
"""ORGM ICMP indicators and full terminal inventory."""

import argparse
import html
import json
import math
import os
import shlex
import subprocess
import sys
from dataclasses import dataclass
from typing import Optional
from urllib.parse import urlencode
from urllib.request import Request, urlopen

PROMETHEUS_URL = "http://100.89.45.64:9090"
QUERY = 'probe_success{job="blackbox-icmp"}'
UP_COLOR = "#1e40af"
DOWN_COLOR = "#f87171"
# Reaching no verdict is not the same as a target being down: when Prometheus
# cannot be queried at all -- this machine is offline, or the server is
# unreachable -- every target would otherwise turn red and claim an outage
# that was never measured.
NO_DATA_COLOR = "#4b5563"
TARGETS = (
    ("nextcloud", "N", "", "Nextcloud"),
    ("fifrex", "F", "", "Fifrex"),
    ("vilserver1", "V", "", "Villarpando"),
    ("orgm", "O", "", "ORGM"),
)


@dataclass(frozen=True)
class Snapshot:
    values: dict[str, str]
    error: Optional[str] = None


def timeout_seconds() -> float:
    try:
        value = float(os.environ.get("ORGM_TIMEOUT_SECONDS", "0.8"))
        return value if math.isfinite(value) and value > 0 else 0.8
    except ValueError:
        return 0.8


def fetch_snapshot() -> Snapshot:
    url = (
        f"{os.environ.get('ORGM_PROMETHEUS_URL', PROMETHEUS_URL).rstrip('/')}"
        f"/api/v1/query?{urlencode({'query': QUERY})}"
    )
    try:
        request = Request(url, headers={"Accept": "application/json"})
        with urlopen(request, timeout=timeout_seconds()) as response:
            payload = json.load(response)
        result = payload["data"]["result"]
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        return Snapshot({}, f"sin datos de Prometheus: {error}")

    values = {}
    for series in result:
        try:
            name = series["metric"]["instance"]
            value = float(series["value"][1])
        except (KeyError, IndexError, TypeError, ValueError):
            continue
        values[name] = "up" if value == 1.0 else "down" if value == 0.0 else "unknown"
    return Snapshot(values)


def target_states(snapshot: Snapshot) -> list[tuple[str, str, str, str, str]]:
    return [
        (instance, letter, icon, name, snapshot.values.get(instance, "unknown"))
        for instance, letter, icon, name in TARGETS
    ]


def color(state: str) -> str:
    if state == "up":
        return UP_COLOR
    return DOWN_COLOR if state == "down" else NO_DATA_COLOR

def state_label(state: str) -> str:
    return "CONECTADO" if state == "up" else "DESCONECTADO" if state == "down" else "SIN DATOS"




def pango_text(snapshot: Snapshot) -> str:
    return " ".join(
        f'<span foreground="{color(state)}">{icon} {html.escape(letter)}</span>'
        for _, letter, icon, _, state in target_states(snapshot)
    )

def i3bar_text(snapshot: Snapshot) -> str:
    return f'{pango_text(snapshot)} <span foreground="#565f89">│</span> '



def tooltip(snapshot: Snapshot) -> str:
    rows = ["Estado ICMP de infraestructura ORGM"]
    for _, letter, _, name, state in target_states(snapshot):
        label = state_label(state)
        rows.append(f"{letter} {name}: {label}")
    if snapshot.error:
        rows.append(snapshot.error)
    rows.append("Clic: abrir vigilancia en terminal")
    return "\n".join(rows)


def waybar() -> None:
    snapshot = fetch_snapshot()
    states = [state for _, _, _, _, state in target_states(snapshot)]
    if all(state == "unknown" for state in states):
        summary = "no-data"
    else:
        summary = "up" if all(state == "up" for state in states) else "down"
    print(
        json.dumps(
            {
                "text": pango_text(snapshot),
                "tooltip": tooltip(snapshot),
                "class": ["orgm-status", summary],
                "markup": "pango",
            },
            ensure_ascii=False,
        )
    )


def i3bar() -> None:
    snapshot = fetch_snapshot()
    print(
        json.dumps(
            {
                "name": "orgm-status",
                "instance": "summary",
                "full_text": i3bar_text(snapshot),
                "markup": "pango",
                "separator": False,
                "separator_block_width": 0,
            },
            ensure_ascii=False,
        )
    )


def watch() -> None:
    snapshot = fetch_snapshot()
    blue = "\033[38;2;56;189;248m"
    red = "\033[38;2;248;113;113m"
    grey = "\033[38;2;107;114;128m"
    reset = "\033[0m"
    print("ORGM · estado ICMP de todos los destinos de Grafana")
    print()
    for instance, state in sorted(snapshot.values.items()):
        tint = blue if state == "up" else red if state == "down" else grey
        print(f"{tint}• {instance}: {state_label(state)}{reset}")
    if snapshot.error:
        print(f"\n{red}{snapshot.error}{reset}")
    print("\nActualización: 5 s · Ctrl+C para cerrar")


def open_terminal() -> None:
    script = shlex.quote(os.path.abspath(sys.argv[0]))
    command = f"exec watch -n 5 -c {script} watch"
    terminal = shlex.split(os.environ.get("ORGM_TERMINAL", "kitty"))
    try:
        subprocess.Popen(
            [*terminal, "--class", "orgm-status", "--title", "ORGM Status", "-e", "bash", "-c", command],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def main() -> None:
    parser = argparse.ArgumentParser(description="Estado de monitores ICMP de ORGM")
    parser.add_argument("mode", choices=("waybar", "i3bar", "watch", "open"))
    mode = parser.parse_args().mode
    {
        "waybar": waybar,
        "i3bar": i3bar,
        "watch": watch,
        "open": open_terminal,
    }[mode]()


if __name__ == "__main__":
    main()
