#!/usr/bin/env bash
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Firefox" "$1" 2>/dev/null || true
}

usage() {
  printf 'Usage: %s [--new] [--prompt] URL | %s --focus\n' "${0##*/}" "${0##*/}" >&2
}

fail() {
  notify "$1"
  usage
  exit 2
}

normalize_url() {
  local value="$1"

  [[ -n "$value" && "$value" != *[[:space:]]* ]] || return 1
  case "$value" in
    http://?*|https://?*|about:?*)
      printf '%s\n' "$value"
      return
      ;;
  esac

  if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^\[[[:xdigit:]:]+\](:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^localhost(:[0-9]+)?(/.*)?$ ]] ||
     [[ "$value" =~ ^[^./:]+:[0-9]+(/.*)?$ ]]; then
    printf 'http://%s\n' "$value"
  elif [[ "$value" =~ ^[[:alpha:]][[:alnum:]+.-]*: ]]; then
    printf '%s\n' "$value"
  elif [[ "$value" == *.* ]]; then
    printf 'https://%s\n' "$value"
  else
    printf 'https://%s.com\n' "$value"
  fi
}

prompt_url() {
  command -v rofi >/dev/null 2>&1 || {
    notify "Rofi is not installed"
    return 1
  }
  rofi -dmenu -i -p "Abrir web"
}

focus_firefox() {
  case "${XDG_CURRENT_DESKTOP:-}" in
    *Hyprland*)
      command -v hyprctl >/dev/null 2>&1 &&
        hyprctl dispatch focuswindow 'class:^(firefox|Navigator)$'
      ;;
    *i3*)
      command -v i3-msg >/dev/null 2>&1 &&
        i3-msg '[class="(?i)firefox"] focus'
      ;;
    *labwc*)
      command -v wlrctl >/dev/null 2>&1 &&
        wlrctl toplevel focus app_id:firefox
      ;;
    *)
      return 1
      ;;
  esac
}

new_tab=false
prompt=false
focus_only=false
input=""

while (($#)); do
  case "$1" in
    --new)
      new_tab=true
      ;;
    --prompt)
      prompt=true
      ;;
    --focus)
      focus_only=true
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || fail "Specify exactly one URL"
      input="$1"
      break
      ;;
    -*)
      fail "Unknown option: $1"
      ;;
    *)
      [[ -z "$input" ]] || fail "Specify exactly one URL"
      input="$1"
      ;;
  esac
  shift
done

if "$focus_only"; then
  [[ "$new_tab" == false && "$prompt" == false && -z "$input" ]] ||
    fail "--focus cannot be combined with a URL or creation options"
  focus_firefox >/dev/null 2>&1 || {
    notify "No existing Firefox window could be focused"
    exit 1
  }
  exit 0
fi

if "$prompt"; then
  [[ -z "$input" ]] || fail "--prompt cannot be combined with a URL"
  input="$(prompt_url || true)"
  [[ -n "$input" ]] || exit 0
fi

if "$new_tab" && [[ "$prompt" == false && -z "$input" ]]; then
  input="about:blank"
fi

[[ -n "$input" ]] || fail "A URL is required"
url="$(normalize_url "$input")" || {
  notify "URL inválida"
  exit 1
}

if "$new_tab"; then
  command -v firefox >/dev/null 2>&1 || {
    notify "Firefox is not installed"
    exit 1
  }
  firefox --new-tab "$url" >/dev/null 2>&1 &
  exit 0
fi

if command -v windows-manager-linux-orgm-tab >/dev/null 2>&1 &&
   windows-manager-linux-orgm-tab "$url" 2>/dev/null; then
  focus_firefox >/dev/null 2>&1 || notify "The Firefox window could not be focused"
  exit 0
fi

notify "No existing Firefox tab could be opened"
exit 1
