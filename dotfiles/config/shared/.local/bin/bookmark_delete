#!/usr/bin/env bash
set -euo pipefail

bookmarks_file=.bookmarks
[[ -r $bookmarks_file ]] || exit 0
bookmark=$(rofi -dmenu -p 'delete bookmark' < "$bookmarks_file") || exit 0
[[ -n $bookmark ]] || exit 0

temporary=$(mktemp "${TMPDIR:-/tmp}/bookmark.XXXXXX")
trap 'rm -f "$temporary"' EXIT
while IFS= read -r line || [[ -n $line ]]; do
  [[ $line == "$bookmark" ]] || printf '%s\n' "$line" >> "$temporary"
done < "$bookmarks_file"
mv "$temporary" "$bookmarks_file"
trap - EXIT
dunstify Bookmarks "Bookmark '$bookmark' was deleted" -t 2000
