#!/usr/bin/env bash

# ============================================================
# Windows VM - Container Manager
# ============================================================

CONTAINER="windows"
INACTIVE_CONTAINER=""
WINDOWS_VM_PROFILE_FILE="${WINDOWS_VM_PROFILE_FILE:-/etc/orgm/windows-vm-profile}"
WINDOWS_VM_PROFILE="render-node"
WINDOWS_COMPOSE_DIR="${WINDOWS_COMPOSE_DIR:-$HOME/Apps/windows}"
COMPOSE_FILES=()
RDP_HOST="localhost"
RDP_PORT="3389"
RDP_USER=""
RDP_PASSWORD_FILE=""
LOCAL_WINDOWS_NAME="osmar-windows"
WEB_CONSOLE_URL="http://127.0.0.1:8006"
WEB_CONSOLE_HOST="127.0.0.1"
WEB_CONSOLE_PORT="8006"

SCRIPT_NAME="windows-rdp"
BIN_DIR="$HOME/.local/bin"
APPS_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons"
ICON_URL="https://icones.pro/wp-content/uploads/2021/06/icone-windows-bleu.png"
ICON_FILE="$ICON_DIR/windows.png"

# Seconds to wait after port is open for RDP to fully initialize
RDP_BOOT_DELAY=10

declare -a TARGET_LABELS=()
declare -a TARGET_PROTOCOLS=()
declare -a TARGET_HOSTNAMES=()
declare -a TARGET_ADDRESSES=()
SELECTED_TARGET_INDEX=""

# ============================================================
# Functions
# ============================================================

container_cmd() {
  if command -v docker &>/dev/null; then
    docker "$@" 2>/dev/null
  elif command -v podman &>/dev/null; then
    podman "$@" 2>/dev/null
  else
    echo "Error: Neither docker nor podman found."
    exit 1
  fi
}

select_vm_profile() {
  if [[ -r "$WINDOWS_VM_PROFILE_FILE" ]]; then
    read -r WINDOWS_VM_PROFILE <"$WINDOWS_VM_PROFILE_FILE"
  fi

  case "$WINDOWS_VM_PROFILE" in
    lenovo-vfio)
      CONTAINER="lenovo-windows"
      INACTIVE_CONTAINER="windows"
      COMPOSE_FILES=(-f compose.yml -f compose.lenovo-vfio.yml)
      LOCAL_WINDOWS_NAME="lenovo-windows"
      ;;
    *)
      CONTAINER="windows"
      COMPOSE_FILES=()
      LOCAL_WINDOWS_NAME="osmar-windows"
      ;;
  esac
}

compose_cmd() {
  if command -v docker &>/dev/null; then
    docker compose "$@"
  elif command -v podman &>/dev/null; then
    podman compose "$@"
  else
    echo "Error: Neither docker nor podman found." >&2
    return 1
  fi
}

is_installed() {
  [[ -x "$BIN_DIR/$SCRIPT_NAME" ]] && [[ -f "$APPS_DIR/$SCRIPT_NAME.desktop" ]]
}

notify_user() {
  local title="$1"
  local body="${2:-}"
  local icon="$ICON_FILE"

  # Sway/mako use the standard desktop notification protocol.
  # notify-send talks to mako, swaync, dunst, etc. when available.
  local is_sway=0
  local has_mako=0
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *sway* ]] || [[ "${SWAYSOCK:-}" != "" ]]; then
    is_sway=1
  elif command -v swaymsg &>/dev/null && swaymsg -t get_version &>/dev/null; then
    is_sway=1
  fi
  if pgrep -x mako &>/dev/null; then
    has_mako=1
  elif command -v makoctl &>/dev/null && makoctl mode &>/dev/null; then
    has_mako=1
  fi

  if command -v notify-send &>/dev/null && { [[ $is_sway -eq 1 ]] || [[ $has_mako -eq 1 ]] || [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; }; then
    if [[ -f "$icon" ]]; then
      notify-send -a "$SCRIPT_NAME" -i "$icon" "$title" "$body" 2>/dev/null || true
    else
      notify-send -a "$SCRIPT_NAME" "$title" "$body" 2>/dev/null || true
    fi
  else
    echo "$title${body:+ $body}"
  fi
}

current_hypr_workspace() {
  if ! command -v hyprctl &>/dev/null || ! command -v jq &>/dev/null; then
    return 0
  fi

  hyprctl -j activeworkspace 2>/dev/null | jq -r '(.id // empty) as $id | if ($id | type) == "number" and $id > 0 then ($id | tostring) else (.name // empty) end' 2>/dev/null || true
}

focused_monitor_size() {
  local size=""

  if command -v hyprctl &>/dev/null && command -v jq &>/dev/null; then
    size="$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.focused and .width >= 200 and .height >= 200) | "\(.width)x\(.height)"] | first // empty' 2>/dev/null || true)"
  fi

  printf '%s\n' "${size:-1920x1080}"
}

move_next_rdp_window_to_workspace() {
  local workspace="$1"
  [[ -n "$workspace" ]] || return 0
  if ! command -v hyprctl &>/dev/null || ! command -v jq &>/dev/null; then
    return 0
  fi

  (
    local address=""
    for _ in $(seq 1 80); do
      address="$(hyprctl -j clients 2>/dev/null | jq -r '.[] | select((.class // "") == "windows-rdp" or (.initialClass // "") == "windows-rdp") | .address' 2>/dev/null | head -n 1)"
      if [[ -n "$address" && "$address" != "null" ]]; then
        hyprctl dispatch movetoworkspacesilent "$workspace,address:$address" >/dev/null 2>&1 || true
        return 0
      fi
      sleep 0.1
    done
  ) &
}

container_is_running() {
  [[ "$(container_cmd inspect --format '{{.State.Running}}' "$CONTAINER")" == true ]]
}

report_container_failure() {
  local status
  status="$(container_cmd inspect --format '{{.State.Status}} (exit {{.State.ExitCode}})' "$CONTAINER" || true)"
  echo "Container '$CONTAINER' failed: ${status:-not found}." >&2
  echo "----- $CONTAINER logs (last 60 lines) -----" >&2
  container_cmd logs --tail 60 "$CONTAINER" || true
  echo "---------------------------------------------" >&2
  notify_user "Windows VM error" "El contenedor '$CONTAINER' falló; revisa la terminal."
}

wait_for_service_port() {
  local host="$1"
  local port="$2"
  local service="$3"
  local boot_delay="${4:-0}"

  echo "Waiting for $service on $host:$port..."
  for _ in $(seq 1 60); do
    if ! container_is_running; then
      report_container_failure
      return 1
    fi

    if nc -z "$host" "$port" 2>/dev/null; then
      if [[ "$boot_delay" -gt 0 ]]; then
        echo "Port open. Waiting ${boot_delay}s for Windows to finish booting..."
        sleep "$boot_delay"
        if ! container_is_running || ! nc -z "$host" "$port" 2>/dev/null; then
          report_container_failure
          return 1
        fi
      fi
      echo "$service is ready."
      return 0
    fi
    sleep 2
  done
  echo "Error: $service did not become available after 120s." >&2
  report_container_failure
  return 1
}

wait_rdp() {
  wait_for_service_port "$RDP_HOST" "$RDP_PORT" "RDP" "$RDP_BOOT_DELAY"
}

wait_web_console() {
  wait_for_service_port "$WEB_CONSOLE_HOST" "$WEB_CONSOLE_PORT" "Windows Web Console"
}

rdp_command() {
  local -a client_cmd
  local backend=""
  RDP_FULLSCREEN=1

  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v sdl-freerdp &>/dev/null; then
    # SDL's Wayland client has a visible cursor on Hyprland. wlfreerdp has a
    # known invisible-cursor bug despite otherwise rendering the RDP session.
    backend="wayland"
    client_cmd=(/usr/bin/env SDL_VIDEODRIVER=wayland sdl-freerdp)
    # FreeRDP SDL overrides /size with the Wayland surface dimensions in
    # fullscreen mode. On this host that surface can be 64x64, which FreeRDP
    # rejects before connecting. Keep the requested monitor size in a window.
    RDP_FULLSCREEN=0
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wlfreerdp &>/dev/null; then
    backend="wayland"
    client_cmd=(wlfreerdp)
  elif command -v xfreerdp &>/dev/null; then
    backend="x11"
    client_cmd=(xfreerdp)
  elif command -v xfreerdp3 &>/dev/null; then
    backend="x11"
    client_cmd=(xfreerdp3)
  else
    echo "Error: FreeRDP client not found." >&2
    return 1
  fi

  if [[ "$backend" == x11 && "$WINDOWS_VM_PROFILE" != lenovo-vfio ]]; then
    if command -v nvidia-offload &>/dev/null; then
      RDP_CMD=(nvidia-offload "${client_cmd[@]}")
    elif command -v prime-run &>/dev/null; then
      RDP_CMD=(prime-run "${client_cmd[@]}")
    else
      RDP_CMD=("${client_cmd[@]}")
    fi
  else
    RDP_CMD=("${client_cmd[@]}")
  fi
}

load_rdp_credentials() {
  local selected_host="${1,,}"
  local credential_host credential_key user_var password_file_var

  case "$selected_host" in
    orgm | orgm-windows) credential_host="osmar-windows" ;;
    lenovo | lenovo-windows) credential_host="lenovo-windows" ;;
    *) credential_host="$selected_host" ;;
  esac
  credential_key="${credential_host^^}"
  credential_key="${credential_key//-/_}"
  user_var="WINDOWS_RDP_${credential_key}_USER"
  password_file_var="WINDOWS_RDP_${credential_key}_PASSWORD_FILE"
  RDP_USER="${!user_var:-}"
  RDP_PASSWORD_FILE="${!password_file_var:-}"

  if [[ -z "$RDP_USER" || -z "$RDP_PASSWORD_FILE" || ! -r "$RDP_PASSWORD_FILE" || ! -s "$RDP_PASSWORD_FILE" ]]; then
    echo "Error: RDP host '$selected_host' requires $user_var and $password_file_var." >&2
    return 1
  fi
}

rdp_connect() {
  local target_workspace="${1:-}"
  local rdp_size rdp_password="${2:-}"
  local -a RDP_CMD
  local -a rdp_display_options=()

  rdp_size="$(focused_monitor_size)"
  rdp_command || return 1
  if [[ "$RDP_FULLSCREEN" == 1 ]]; then
    rdp_display_options=(/f)
  fi

  move_next_rdp_window_to_workspace "$target_workspace"
  if [[ -z "$rdp_password" ]]; then
    rdp_password="$(<"$RDP_PASSWORD_FILE")"
  fi
  if [[ -z "$rdp_password" ]]; then
    echo "Error: RDP password is empty." >&2
    return 1
  fi
  # Do not grab the physical keyboard: local compositor shortcuts remain usable.
  # A client exit, including a Windows-side disconnect, is final; reconnecting is
  # always an explicit user action.
  "${RDP_CMD[@]}" /v:"$RDP_HOST":"$RDP_PORT" \
    /u:"$RDP_USER" \
    /p:"$rdp_password" \
    /size:"$rdp_size" \
    "${rdp_display_options[@]}" \
    /admin \
    /sec:nla \
    /tls:seclevel:0 \
    /network:lan \
    /bpp:32 \
    /audio-mode:0 \
    +clipboard \
    /gdi:sw \
    -grab-keyboard \
    /cert:ignore \
    /wm-class:windows-rdp
}

append_target() {
  TARGET_LABELS+=("$1")
  TARGET_PROTOCOLS+=("$2")
  TARGET_HOSTNAMES+=("$3")
  TARGET_ADDRESSES+=("$4")
}

build_targets() {
  local status_json peers host ip state

  TARGET_LABELS=()
  TARGET_PROTOCOLS=()
  TARGET_HOSTNAMES=()
  TARGET_ADDRESSES=()
  append_target "Local | $LOCAL_WINDOWS_NAME | RDP" "rdp-local" "$LOCAL_WINDOWS_NAME" "localhost"
  append_target "Local | $LOCAL_WINDOWS_NAME | Iniciar contenedor" "local-start" "$LOCAL_WINDOWS_NAME" "localhost"
  append_target "Custom | RDP" "rdp-custom" "" ""

  if ! command -v tailscale &>/dev/null || ! command -v jq &>/dev/null; then
    echo "Warning: Tailscale or jq is unavailable; showing local Windows only." >&2
    return 0
  fi
  if ! status_json="$(tailscale status --json 2>&1)"; then
    echo "Warning: tailscale status failed; showing local Windows only: $status_json" >&2
    return 0
  fi
  if ! peers="$(printf '%s\n' "$status_json" | jq -r '
    (.Peer // {})
    | if type == "object" then to_entries | map(.value)
      elif type == "array" then .
      else [] end
    | map(select((.Self // false) | not))
    | map({
        host: ((.HostName // .HostInfo.HostName // "") | ascii_downcase),
        ip: (.TailscaleIPs[0] // "sin-ip"),
        state: (if (.Online // false) then "online" else "offline" end)
      })
    | map(select(.host != ""))
    | sort_by(.host)
    | .[]
    | "\(.host)\t\(.ip)\t\(.state)"
  ')"; then
    echo "Warning: could not parse Tailscale status; showing local Windows only." >&2
    return 0
  fi

  while IFS=$'\t' read -r host ip state; do
    [[ -n "$host" && "$host" != "$LOCAL_WINDOWS_NAME" ]] || continue
    case "$host" in
      *windows* | orgm | lenovo) ;;
      *) continue ;;
    esac
    if [[ "$ip" == sin-ip ]]; then
      echo "Warning: Tailscale peer '$host' has no usable Tailscale IP; skipping RDP." >&2
      continue
    fi
    append_target "Tailscale | $host | RDP | $state" "rdp-tailscale" "$host" "$ip"
  done <<<"$peers"

  while IFS=$'\t' read -r host ip state; do
    [[ "$host" == orgm || "$host" == lenovo ]] || continue
    if [[ "$ip" == sin-ip ]]; then
      echo "Warning: Tailscale peer '$host' has no usable Tailscale IP; skipping Moonlight." >&2
      continue
    fi
    append_target "Tailscale | $host | Moonlight | $state" "moonlight" "$host" "$ip"
  done <<<"$peers"
}

choose_target() {
  local selected index

  SELECTED_TARGET_INDEX=""
  if [[ -t 0 && -t 1 ]] && command -v gum &>/dev/null; then
    selected="$(gum choose --cursor.foreground "#2563EB" --selected.foreground "#2563EB" --header "Selecciona un equipo" "${TARGET_LABELS[@]}")" || return 0
    [[ -n "$selected" ]] || return 0
    for index in "${!TARGET_LABELS[@]}"; do
      [[ "${TARGET_LABELS[$index]}" == "$selected" ]] && {
        SELECTED_TARGET_INDEX="$index"
        return 0
      }
    done
    echo "Error: Gum returned an unknown target." >&2
    return 1
  fi

  if [[ ! -t 0 || ! -t 1 ]] && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    if ! command -v rofi &>/dev/null; then
      echo "Error: Rofi is required by the graphical remote selector." >&2
      notify_user "Selector remoto no disponible" "Rofi no está instalado."
      return 1
    fi
    selected="$(printf '%s\n' "${TARGET_LABELS[@]}" | rofi -dmenu -i -no-custom -only-match -format i -p "Conectar remoto")" || return 0
    [[ -n "$selected" ]] || return 0
    [[ "$selected" =~ ^[0-9]+$ && "$selected" -lt "${#TARGET_LABELS[@]}" ]] || {
      echo "Error: Rofi returned an invalid target index." >&2
      return 1
    }
    SELECTED_TARGET_INDEX="$selected"
    return 0
  fi

  while true; do
    for index in "${!TARGET_LABELS[@]}"; do
      printf '%d) %s\n' "$((index + 1))" "${TARGET_LABELS[$index]}" >&2
    done
    printf 'Selecciona un equipo: ' >&2
    selected=""
    if ! read -r selected; then
      if [[ "$selected" =~ ^[0-9]+$ ]] && (( selected >= 1 && selected <= ${#TARGET_LABELS[@]} )); then
        SELECTED_TARGET_INDEX="$((selected - 1))"
      elif [[ -n "$selected" ]]; then
        echo "Selecciona un número válido." >&2
      fi
      return 0
    fi
    if [[ "$selected" =~ ^[0-9]+$ ]] && (( selected >= 1 && selected <= ${#TARGET_LABELS[@]} )); then
      SELECTED_TARGET_INDEX="$((selected - 1))"
      return 0
    fi
    echo "Selecciona un número válido." >&2
  done
}

do_moonlight_connect() {
  local address="$1" apps app

  if ! command -v flatpak &>/dev/null || ! flatpak info com.moonlight_stream.Moonlight &>/dev/null; then
    echo "Error: Flatpak Moonlight is not installed." >&2
    notify_user "Moonlight no disponible" "Instala com.moonlight_stream.Moonlight para conectar."
    return 1
  fi
  if ! apps="$(flatpak run com.moonlight_stream.Moonlight list "$address" 2>&1)"; then
    notify_user "Moonlight requiere configuración" "Abriendo Moonlight para emparejar o revisar '$address'."
    flatpak run com.moonlight_stream.Moonlight
    return
  fi
  while IFS= read -r app; do
    if [[ "$app" == Desktop ]]; then
      flatpak run com.moonlight_stream.Moonlight stream "$address" Desktop
      return
    fi
  done <<<"$apps"
  notify_user "Moonlight requiere configuración" "El host '$address' no expone Desktop; abriendo Moonlight."
  flatpak run com.moonlight_stream.Moonlight
}

do_custom_rdp_connect() {
  local address user password result

  if [[ ! -t 0 || ! -t 1 ]] && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    if ! command -v rofi &>/dev/null; then
      echo "Error: Rofi is required for custom graphical RDP." >&2
      notify_user "RDP personalizado no disponible" "Rofi no está instalado."
      return 1
    fi
    address="$(printf '\n' | rofi -dmenu -i -p "IP RDP")" || return 0
    user="$(printf '\n' | rofi -dmenu -i -p "Usuario RDP")" || return 0
    password="$(printf '\n' | rofi -dmenu -password -p "Clave RDP")" || return 0
  else
    printf 'IP RDP: ' >&2
    address=""
    if ! IFS= read -r address && [[ -z "$address" ]]; then
      return 0
    fi
    printf 'Usuario RDP: ' >&2
    user=""
    if ! IFS= read -r user && [[ -z "$user" ]]; then
      return 0
    fi
    printf 'Clave RDP: ' >&2
    password=""
    if ! IFS= read -r -s password && [[ -z "$password" ]]; then
      printf '\n' >&2
      return 0
    fi
    printf '\n' >&2
  fi

  if [[ -z "$address" || -z "$user" || -z "$password" ]]; then
    echo "Error: IP, usuario y clave RDP son obligatorios." >&2
    return 1
  fi

  RDP_HOST="$address"
  RDP_PORT=3389
  RDP_USER="$user"
  RDP_PASSWORD_FILE=""
  rdp_connect "$(current_hypr_workspace)" "$password"
  result=$?
  password=""
  return "$result"
}

do_choose_connect() {
  local protocol hostname address

  build_targets
  choose_target || return $?
  [[ -n "$SELECTED_TARGET_INDEX" ]] || return 0
  protocol="${TARGET_PROTOCOLS[$SELECTED_TARGET_INDEX]}"
  hostname="${TARGET_HOSTNAMES[$SELECTED_TARGET_INDEX]}"
  address="${TARGET_ADDRESSES[$SELECTED_TARGET_INDEX]}"

  case "$protocol" in
    local-start)
      if container_is_running; then
        echo "Local Windows container '$CONTAINER' is already running."
      else
        do_start
      fi
      ;;
    rdp-local)
      do_connect
      ;;
    rdp-custom)
      do_custom_rdp_connect
      ;;
    rdp-tailscale)
      RDP_HOST="$address"
      RDP_PORT=3389
      load_rdp_credentials "$hostname" || return 1
      rdp_connect "$(current_hypr_workspace)"
      ;;
    moonlight)
      do_moonlight_connect "$address"
      ;;
    *)
      echo "Error: unsupported remote protocol '$protocol'." >&2
      return 1
      ;;
  esac
}

require_vfio_memlock() {
  local hard_limit
  hard_limit="$(ulimit -Hl)"

  if [[ "$hard_limit" != unlimited ]]; then
    echo "Error: VFIO requires an unlimited memlock limit; current hard limit is ${hard_limit} KiB." >&2
    echo 'Run this in the same terminal, then retry: sudo prlimit --pid $$ --memlock=unlimited' >&2
    notify_user "Windows VFIO error" "Ejecuta prlimit en la misma terminal antes de iniciar Windows."
    return 1
  fi
}

do_looking_glass() {
  if [[ "$WINDOWS_VM_PROFILE" != lenovo-vfio ]]; then
    echo "Error: Looking Glass is available only for the Lenovo VFIO Windows profile." >&2
    return 1
  fi

  if [[ ! -e /dev/kvmfr0 ]]; then
    echo "Error: /dev/kvmfr0 is unavailable; boot a Lenovo Windows profile with Looking Glass enabled." >&2
    return 1
  fi

  if ! container_is_running; then
    echo "Windows is not running. Starting '$CONTAINER'..."
    do_start || return 1
  else
    wait_rdp || return 1
  fi

  exec looking-glass-client -m 88 -p 5901
}

# ============================================================
# Commands
# ============================================================

do_start() {
  # Pass 0 for callers that need a service other than RDP after startup.
  local wait_for_rdp="${1:-1}"
  if [[ "$WINDOWS_VM_PROFILE" == lenovo-vfio ]]; then
    if [[ ! -e /dev/vfio/16 ]]; then
      echo "Error: /dev/vfio/16 is unavailable; boot the Lenovo VFIO profile first." >&2
      return 1
    fi
    if [[ ! -e /dev/kvmfr0 ]]; then
      echo "Error: /dev/kvmfr0 is unavailable; boot a Lenovo Windows profile with Looking Glass enabled." >&2
      return 1
    fi
    require_vfio_memlock || return 1
  fi

  notify_user "Windows iniciando!" "Iniciando contenedor '$CONTAINER'."
  echo "Starting container '$CONTAINER'..."

  if [[ "$WINDOWS_VM_PROFILE" == lenovo-vfio ]]; then
    container_cmd rm -f "$INACTIVE_CONTAINER" || true
    if ! (
      cd "$WINDOWS_COMPOSE_DIR"
      compose_cmd --env-file .env "${COMPOSE_FILES[@]}" up -d --build
    ); then
      report_container_failure
      return 1
    fi
  elif ! container_cmd start "$CONTAINER"; then
    report_container_failure
    return 1
  fi

  if [[ "$wait_for_rdp" == 1 ]]; then
    wait_rdp || return 1
    notify_user "Windows iniciado" "Contenedor '$CONTAINER' y RDP listos."
  else
    notify_user "Contenedor Windows iniciado" "El contenedor '$CONTAINER' está en ejecución."
  fi
}

do_stop() {
  notify_user "Windows apagando" "Deteniendo contenedor '$CONTAINER'."
  echo "Stopping container '$CONTAINER'..."
  if ! container_cmd stop "$CONTAINER"; then
    report_container_failure
    return 1
  fi
  echo "Container stopped."
  notify_user "Windows detenido" "Contenedor '$CONTAINER' detenido."
}

do_toggle() {
  if container_is_running; then
    do_stop
  else
    do_start
  fi
}

do_status() {
  local -a RDP_CMD

  rdp_command
  printf 'profile=%s\ncontainer=%s\nclient=' "$WINDOWS_VM_PROFILE" "$CONTAINER"
  printf '%q ' "${RDP_CMD[@]}"
  printf '\n'
}

do_connect() {
  local target_workspace=""

  RDP_HOST=localhost
  RDP_PORT=3389
  load_rdp_credentials "$LOCAL_WINDOWS_NAME" || return 1
  target_workspace="$(current_hypr_workspace)"

  if ! nc -z "$RDP_HOST" "$RDP_PORT" 2>/dev/null; then
    echo "RDP is not available. Starting container '$CONTAINER'..."
    do_start || return 1
  fi

  rdp_connect "$target_workspace"
}
open_web_console() {
  if command -v firefox-open-tab &>/dev/null && firefox-open-tEB_CONSOLE_URL"; then
    return 0
  fi

  if command -v firefox &>/dev/null; then
    firefox --new-tab "$WEB_CONSOLE_URL" &
    return 0
  fi

  echo "Error: Firefox tab helper and Firefox are unavailable." >&2
  notify_user "Windows Web Console error" "Firefox no está disponible para abrir la consola web."
  return 1
}

do_web() {
  if ! container_is_running; then
    echo "Windows Web Console is unavailable. Starting container '$CONTAINER'..."
    do_start 0 || return 1
  fi

  wait_web_console || return 1
  open_web_console
}


do_run() {
  do_connect
}

do_install() {
  echo "Installing $SCRIPT_NAME..."

  mkdir -p "$BIN_DIR"
  cp "$(realpath "$0")" "$BIN_DIR/$SCRIPT_NAME"
  chmod +x "$BIN_DIR/$SCRIPT_NAME"
  echo "  Script  -> $BIN_DIR/$SCRIPT_NAME"

  # Download icon
  mkdir -p "$ICON_DIR"
  if command -v curl &>/dev/null; then
    curl -sL "$ICON_URL" -o "$ICON_FILE"
  elif command -v wget &>/dev/null; then
    wget -q "$ICON_URL" -O "$ICON_FILE"
  else
    echo "  Warning: curl/wget not found, skipping icon download."
  fi
  echo "  Icon    -> $ICON_FILE"

  # Create desktop launchers.
  mkdir -p "$APPS_DIR"
  cat >"$APPS_DIR/$SCRIPT_NAME.desktop" <<EOF
[Desktop Entry]
Name=Windows VM (RDP)
Comment=Connect to Windows via RDP
Exec=$BIN_DIR/$SCRIPT_NAME connect
Icon=$ICON_FILE
Terminal=false
Type=Application
Categories=System;RemoteAccess;
Keywords=windows;rdp;vm;container;
StartupWMClass=windows-rdp
EOF
  chmod +x "$APPS_DIR/$SCRIPT_NAME.desktop"
  echo "  Desktop -> $APPS_DIR/$SCRIPT_NAME.desktop"

  cat >"$APPS_DIR/windows-web-console.desktop" <<EOF
[Desktop Entry]
Name=Windows VM (Web Console)
Comment=Open the Windows VM web console
Exec=$BIN_DIR/$SCRIPT_NAME web
Icon=$ICON_FILE
Terminal=false
Type=Application
Categories=System;RemoteAccess;
Keywords=windows;web;console;vm;container;
EOF
  chmod +x "$APPS_DIR/windows-web-console.desktop"
  echo "  Web     -> $APPS_DIR/windows-web-console.desktop"

  echo "Install complete. '$SCRIPT_NAME' is now available."
}

# ============================================================
# Usage
# ============================================================

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command>

Commands:
  run        Connect directly to the local Windows VM; start it if needed
  start      Start the local Windows container only
  stop       Stop the local Windows container only
  toggle     Stop the selected local container if running, otherwise start it
  connect    Select local, custom, Tailscale RDP, or Moonlight access
  web        Start the selected local container if needed and open its Web Console
  looking-glass
             Start the Lenovo VFIO Windows VM if needed and open Looking Glass
  status     Show the selected VM profile and RDP client
  install    Install script, icon and desktop launchers

EOF
}

# ============================================================
# Main
# ============================================================

select_vm_profile

case "${1:-}" in
run) do_run ;;
start) do_start ;;
stop) do_stop ;;
toggle) do_toggle ;;
connect) do_choose_connect ;;
web) do_web ;;
status) do_status ;;
looking-glass) do_looking_glass ;;
install) do_install ;;
-h | --help) usage ;;
"")
  if is_installed; then
    do_run
  else
    do_install
  fi
  ;;
*)
  echo "Unknown command: $1"
  usage
  exit 1
  ;;
esac
