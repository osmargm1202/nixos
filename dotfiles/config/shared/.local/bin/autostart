#!/usr/bin/env bash
# Start session helpers without making any one long-running process own this shell.
pypr &
hypridle &
waybar-watch "$HOME/.config/waybar-hypr" &
poweralertd -s &
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &
wl-clip-persist --clipboard regular &
avizo-service &
exec systemctl --user start psi-notify
