# Loaded by blesh after it has initialized its editing API.
# Normal mode: steady block. Insert mode after i/I: steady I-beam.
bleopt default_keymap=vi
bleopt complete_auto_complete=1 complete_auto_history=1
ble-face auto_complete=fg=242
ble-bind -m vi_nmap --cursor 2
ble-bind -m vi_imap --cursor 6

# blesh owns PROMPT_COMMAND. Register the separator through its pre-prompt
# hook instead of replacing its deferred attach command.
_orgm_command_separator() {
  local glyph=${BASH_COMMAND_SEPARATOR_GLYPH:-·}
  local columns=${COLUMNS:-80}
  local line=

  if [[ -z ${__ORGM_PROMPT_SEEN:-} ]]; then
    __ORGM_PROMPT_SEEN=1
    return
  fi

  while ((${#line} < columns)); do
    line+=$glyph
  done
  printf '\e[90m%s\e[0m\n' "${line:0:columns}"
}
blehook PRECMD+=_orgm_command_separator

if command -v fzf >/dev/null && declare -F ble-import >/dev/null; then
  ble-import contrib/integration/fzf-key-bindings
  blesh_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash"
  if [[ -r "$blesh_config_dir/fzf-widgets.bash" ]]; then
    . "$blesh_config_dir/fzf-widgets.bash"
  fi
  unset blesh_config_dir
fi
