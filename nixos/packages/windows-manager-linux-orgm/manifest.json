{
  "manifest_version": 2,
  "name": "windows_manager_linux_orgm",
  "version": "1.0.2",
  "description": "Focuses an existing browser tab for a requested web application URL.",
  "browser_specific_settings": {
    "gecko": {
      "id": "windows_manager_linux_orgm@or-gm.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "persistent": true,
    "scripts": ["background.js"]
  },
  "permissions": ["nativeMessaging", "tabs"]
}
