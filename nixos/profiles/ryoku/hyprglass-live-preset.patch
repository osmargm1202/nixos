 static std::vector<SPendingLayer> s_pendingLayers;
 
+// A live Hub preview is not followed by configReloaded. Publish only its
+// preset, preserving all other custom presets and pending configuration.
+static int handleLuaApplyPreset(lua_State* L) {
+    const auto result = handleLuaPreset(L);
+    const auto name = stripDynamicTagMarker(lua_tostring(L, 1));
+    if (g_pGlobalState) {
+        if (const auto it = s_pendingPresets.find(name); it != s_pendingPresets.end())
+            g_pGlobalState->customPresets.insert_or_assign(name, it->second);
+    }
+    return result;
+}
