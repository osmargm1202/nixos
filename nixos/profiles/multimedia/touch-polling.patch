diff --git a/orgm_home/touch/PollingProcess.qml b/orgm_home/touch/PollingProcess.qml
new file mode 100644
index 0000000..173577e
--- /dev/null
+++ b/orgm_home/touch/PollingProcess.qml
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+import Quickshell.Io
+
+Process {
+    id: worker
+
+    required property string action
+    property bool pending: false
+    signal received(string data)
+
+    command: ["orgm-home-control", "poll", action]
+    stdinEnabled: true
+
+    function poll() {
+        if (!running) {
+            running = true;
+        } else if (!pending) {
+            pending = true;
+            write("poll\n");
+        }
+    }
+
+    onStarted: poll()
+    onExited: pending = false
+    stdout: SplitParser {
+        onRead: data => {
+            worker.pending = false;
+            worker.received(data);
+        }
+    }
+}
